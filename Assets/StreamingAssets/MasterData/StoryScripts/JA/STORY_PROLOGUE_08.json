{
    "SchemaVersion": 1,
    "StoryId": "STORY_PROLOGUE_08",
    "Lines": [
        {
            "LineId": 1,
            "SpeakerName": "",
            "Text": "ドン、ドン、ドン——!"
        },
        {
            "LineId": 2,
            "SpeakerName": "",
            "Text": "バックステージの鉄の床を揺らす、心臓の鼓動のようなベースの音。"
        },
        {
            "LineId": 3,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 4,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 5,
            "SpeakerName": "若手作家",
            "Text": "(無線機を手に、切迫した様子で叫ぶ)はい、次の出番入ります!V.E.L.O、スタンバイお願いします!"
        },
        {
            "LineId": 6,
            "SpeakerName": "",
            "Text": "生放送の熱気で沸き立つ空気。"
        },
        {
            "LineId": 7,
            "SpeakerName": "",
            "Text": "その息詰まる緊張感の中、リアの指先が微かに震えている。"
        },
        {
            "LineId": 8,
            "SpeakerName": "ジウ",
            "Text": ""
        },
        {
            "LineId": 9,
            "SpeakerName": "ハナ",
            "Text": ""
        },
        {
            "LineId": 10,
            "SpeakerName": "ミナ",
            "Text": ""
        },
        {
            "LineId": 11,
            "SpeakerName": "ミナ",
            "Text": ""
        },
        {
            "LineId": 12,
            "SpeakerName": "ソユン",
            "Text": "(軽く足踏みしながら)オッケー!あの放送局のメインカメラ、あたしが全部ぶっ壊してあげる!"
        },
        {
            "LineId": 13,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 14,
            "SpeakerName": "",
            "Text": "ウィィィン——"
        },
        {
            "LineId": 15,
            "SpeakerName": "",
            "Text": "ついにステージへ通じるゲートが開き、子どもたちが眩い照明の下へと歩み出ていく。"
        },
        {
            "LineId": 16,
            "SpeakerName": "",
            "Text": "数百人の観客が放つ熱気と、数十台のカメラ。"
        },
        {
            "LineId": 17,
            "SpeakerName": "",
            "Text": "初めて踏みしめる、最高級のステージの床の感触。"
        },
        {
            "LineId": 18,
            "SpeakerName": "",
            "Text": "子どもたちがフォーメーションを組んだ瞬間、心臓を打ち抜くような強烈なイントロのビートが、放送局のスピーカーを引き裂いて流れ出す。"
        },
        {
            "LineId": 19,
            "SpeakerName": "",
            "Text": "音楽が始まり、少女たちの眼光が一変する。"
        },
        {
            "LineId": 20,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 21,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 22,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 23,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 24,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 25,
            "SpeakerName": "",
            "Text": "ステージの袖でその姿を見守るPの血走った目に、熱いものが込み上げる。"
        },
        {
            "LineId": 26,
            "SpeakerName": "",
            "Text": "曲は今や、一気に弾け上がるハイライトへと駆け上がっていた。"
        },
        {
            "LineId": 27,
            "SpeakerName": "",
            "Text": "リアが大きく息を吸い込み、ソユンがステージ中央へ切り込もうとした——まさに、その刹那だった。"
        },
        {
            "LineId": 28,
            "SpeakerName": "",
            "Text": "バツンッ——!!"
        },
        {
            "LineId": 29,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 30,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 31,
            "SpeakerName": "",
            "Text": "漆黒の闇、そして突然の静寂。"
        },
        {
            "LineId": 32,
            "SpeakerName": "",
            "Text": "客席から、戸惑う人々のざわめきが湧き上がる。"
        },
        {
            "LineId": 33,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 34,
            "SpeakerName": "",
            "Text": "だが——照明も音楽も、すべてが死に絶えた真っ暗なステージの上。"
        },
        {
            "LineId": 35,
            "SpeakerName": "",
            "Text": "戸惑って立ち止まるはずだったその闇の中から、不気味なほど重く、正確な摩擦音が響き始める。"
        },
        {
            "LineId": 36,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 37,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 38,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 39,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 40,
            "SpeakerName": "",
            "Text": "伴奏の途切れた静寂の中、リアが血を吐くように、伴奏なき生の声で、ハイライトの高音を必死に張り上げる。"
        },
        {
            "LineId": 41,
            "SpeakerName": "",
            "Text": "その凄絶な歌声に合わせ、ソユンとミナが闇を切り裂いてステップを踏む。"
        },
        {
            "LineId": 42,
            "SpeakerName": "",
            "Text": "何としても、あと一秒でもこのステージを続けるのだという、必死のあがきだった。"
        },
        {
            "LineId": 43,
            "SpeakerName": "",
            "Text": "だが、華やかな舞台装置と複雑な配線の敷かれたセットは、がらんとした地下室とは違った。"
        },
        {
            "LineId": 44,
            "SpeakerName": "",
            "Text": "ガタタッ——!"
        },
        {
            "LineId": 45,
            "SpeakerName": "ジウ",
            "Text": "きゃあっ!"
        },
        {
            "LineId": 46,
            "SpeakerName": "",
            "Text": "闇の中で動線を移動していたジウが舞台装置に足を取られ、鈍い音とともに床へ崩れ落ちる。"
        },
        {
            "LineId": 47,
            "SpeakerName": "",
            "Text": "足首が不自然な形にねじれ、切り裂くような悲鳴が迸る。"
        },
        {
            "LineId": 48,
            "SpeakerName": "ハナ",
            "Text": "(闇の中で悲鳴を上げる)ジウ!!"
        },
        {
            "LineId": 49,
            "SpeakerName": "",
            "Text": "ステージの袖で見守っていたPの理性が、断ち切れた。"
        },
        {
            "LineId": 50,
            "SpeakerName": "",
            "Text": "彼は行く手を阻む進行スタッフを押しのけ、狂ったようにコンソールへと駆ける。"
        },
        {
            "LineId": 51,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 52,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 53,
            "SpeakerName": "",
            "Text": "単なる放送事故ではなかった。"
        },
        {
            "LineId": 54,
            "SpeakerName": "",
            "Text": "Pの視線が慌ただしく音響コンソールの方へ向く。"
        },
        {
            "LineId": 55,
            "SpeakerName": "",
            "Text": "ヘッドセットを叩きつけた、メインPDの険しく歪んだ顔が見えた。"
        },
        {
            "LineId": 56,
            "SpeakerName": "メインPD",
            "Text": ""
        },
        {
            "LineId": 57,
            "SpeakerName": "メインPD",
            "Text": ""
        },
        {
            "LineId": 58,
            "SpeakerName": "",
            "Text": "資本の暴力が、生放送という聖域のルールさえ、力ずくでねじ伏せた瞬間だった。"
        },
        {
            "LineId": 59,
            "SpeakerName": "FD",
            "Text": "(Pの肩を荒々しく突き飛ばし、苛立ちをぶつける)ああクソッ!さっさと片付けろって言ってんだろ!あいつら、今すぐ引きずり下ろせ!!"
        },
        {
            "LineId": 60,
            "SpeakerName": "",
            "Text": "彼らの目に、Pと少女たちの切実さなど映ってはいなかった。"
        },
        {
            "LineId": 61,
            "SpeakerName": "",
            "Text": "ただ生放送のキューシートを狂わせ、大手事務所の機嫌を損ねさせた、目障りな「障害物」でしかなかった。"
        },
        {
            "LineId": 62,
            "SpeakerName": "",
            "Text": "黒服の屈強なステージスタッフたちが、真っ暗なステージへどやどやと駆け上がる。"
        },
        {
            "LineId": 63,
            "SpeakerName": "",
            "Text": "彼らは倒れて呻くジウの容態を問わなかった。"
        },
        {
            "LineId": 64,
            "SpeakerName": "",
            "Text": "まるで片付けるべき舞台の小道具か荷物でも扱うように、ジウの両腕を乱暴に掴み、ずるずると引きずり始める。"
        },
        {
            "LineId": 65,
            "SpeakerName": "ミナ",
            "Text": ""
        },
        {
            "LineId": 66,
            "SpeakerName": "ミナ",
            "Text": ""
        },
        {
            "LineId": 67,
            "SpeakerName": "ソユン",
            "Text": "離せって言ってるでしょ!!あたしたちのステージ、まだ終わってない!!離せ!!"
        },
        {
            "LineId": 68,
            "SpeakerName": "スタッフ",
            "Text": ""
        },
        {
            "LineId": 69,
            "SpeakerName": "",
            "Text": "成人男性の腕力に、華奢な少女たちが敵うはずもなかった。"
        },
        {
            "LineId": 70,
            "SpeakerName": "",
            "Text": "もがくミナとソユン、怯えて泣くハナ、虚ろな瞳でステージを見つめるリア。"
        },
        {
            "LineId": 71,
            "SpeakerName": "",
            "Text": "そして足首を押さえて苦しむジウまで。"
        },
        {
            "LineId": 72,
            "SpeakerName": "",
            "Text": "五人の少女は埃まみれのゴミのように、ステージの床をずるずると引きずり下ろされていく。"
        },
        {
            "LineId": 73,
            "SpeakerName": "P",
            "Text": "(掴みかかってスタッフを引き剥がしながら喚く)貴様ら!!子どもたちの身体に触るな!!俺が連れて出て行くと言ってるだろうが!!"
        },
        {
            "LineId": 74,
            "SpeakerName": "",
            "Text": "ドガッ——!!"
        },
        {
            "LineId": 75,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 76,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 77,
            "SpeakerName": "メインPD",
            "Text": "よし、照明戻して!10秒後、次のチームすぐ入ります!"
        },
        {
            "LineId": 78,
            "SpeakerName": "",
            "Text": "何事もなかったかのように、再び華やかな照明が灯り、軽快な次のチームの音楽が鳴り響く。"
        },
        {
            "LineId": 79,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 80,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 81,
            "SpeakerName": "",
            "Text": "巨大資本に睨まれた透明人間たちのステージなど、初めからこの世界に、存在してはいなかったのだ。"
        }
    ]
}
