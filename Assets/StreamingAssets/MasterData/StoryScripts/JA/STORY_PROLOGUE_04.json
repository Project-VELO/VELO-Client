{
    "SchemaVersion": 1,
    "StoryId": "STORY_PROLOGUE_04",
    "Lines": [
        {
            "LineId": 1,
            "SpeakerName": "",
            "Text": "カチャ、ギイイィ——"
        },
        {
            "LineId": 2,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 3,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 4,
            "SpeakerName": "",
            "Text": "そこに、Pが立っていた。"
        },
        {
            "LineId": 5,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 6,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 7,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 8,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 9,
            "SpeakerName": "",
            "Text": "Pは役員たちの苛立ちまじりの視線に一瞥もくれず、濡れた革靴を引きずりながら、黒曜石のテーブルへと歩み寄る。"
        },
        {
            "LineId": 10,
            "SpeakerName": "",
            "Text": "そして内ポケットから皺くちゃになった大判の書類封筒をひとつ取り出し、テーブルの上へ無造作に放り投げる。"
        },
        {
            "LineId": 11,
            "SpeakerName": "",
            "Text": "バサッ、バサバサ——"
        },
        {
            "LineId": 12,
            "SpeakerName": "",
            "Text": "封筒が弾け、こぼれ出た書類が冷たいテーブルの上を埋め尽くす。"
        },
        {
            "LineId": 13,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 14,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 15,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 16,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 17,
            "SpeakerName": "ジュヒ",
            "Text": ""
        },
        {
            "LineId": 18,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 19,
            "SpeakerName": "チェ常務",
            "Text": "(テーブルを荒々しく叩きつけながら)待ちたまえ、P!子どもたちの契約解除は良いとしよう。"
        },
        {
            "LineId": 20,
            "SpeakerName": "チェ常務",
            "Text": "だが、君自身はどうするつもりだ?君のプロデューサー専属契約は、まだ2年も残っている。"
        },
        {
            "LineId": 21,
            "SpeakerName": "チェ常務",
            "Text": "S-Tierの看板である君が突然抜ければ、我が社の株価とラインナップに支障が出ることは、計算しなかったのかね!?"
        },
        {
            "LineId": 22,
            "SpeakerName": "",
            "Text": "子どもたちをゴミのように扱い捨てておきながら、金の卵を産むガチョウであるPだけは決して手放せないという、巨大資本のおぞましい強欲だった。"
        },
        {
            "LineId": 23,
            "SpeakerName": "キム専務",
            "Text": ""
        },
        {
            "LineId": 24,
            "SpeakerName": "キム専務",
            "Text": ""
        },
        {
            "LineId": 25,
            "SpeakerName": "キム専務",
            "Text": ""
        },
        {
            "LineId": 26,
            "SpeakerName": "ジュヒ",
            "Text": ""
        },
        {
            "LineId": 27,
            "SpeakerName": "ジュヒ",
            "Text": ""
        },
        {
            "LineId": 28,
            "SpeakerName": "ジュヒ",
            "Text": ""
        },
        {
            "LineId": 29,
            "SpeakerName": "",
            "Text": "懐柔と脅迫、そして甘い妥協案。"
        },
        {
            "LineId": 30,
            "SpeakerName": "",
            "Text": "並の人間なら、その巨大な権力と資本の重みに押し潰され、もう一度膝を折っていただろう。"
        },
        {
            "LineId": 31,
            "SpeakerName": "",
            "Text": "だがPはゆっくりと上体を屈め、黒曜石のテーブルに両手をつく。"
        },
        {
            "LineId": 32,
            "SpeakerName": "",
            "Text": "そしてキム専務とジュヒの顔を交互に見つめながら、血の滲んだ唇を歪めて、奇怪な笑みを浮かべる。"
        },
        {
            "LineId": 33,
            "SpeakerName": "P",
            "Text": "封筒の中の書類、最後まで読んでないみたいだな。"
        },
        {
            "LineId": 34,
            "SpeakerName": "P",
            "Text": "俺のプロデューサー専属契約の解約違約金まで、全部あの中に叩き込んである。"
        },
        {
            "LineId": 35,
            "SpeakerName": "P",
            "Text": "俺の喉元を締め上げてきた、てめえらのその忌々しい首輪はな——俺が全財産をはたいて、この手で引きちぎってやったんだよ。"
        },
        {
            "LineId": 36,
            "SpeakerName": "チェ常務",
            "Text": ""
        },
        {
            "LineId": 37,
            "SpeakerName": "P",
            "Text": "これで俺も、あの子たちも、S-Tierとは1ウォンたりとも関わりのない赤の他人だ。"
        },
        {
            "LineId": 38,
            "SpeakerName": "P",
            "Text": "てめえらの作ったこの吐き気のするルールの中でうちの子たちを失うくらいなら、俺がどん底の泥沼を這いずってでも、自分の手でステージを作ってやる。"
        },
        {
            "LineId": 39,
            "SpeakerName": "P",
            "Text": "だから二度と、うちの子たちにその汚い手で触れるな。"
        },
        {
            "LineId": 40,
            "SpeakerName": "",
            "Text": "一寸の揺らぎもない、狂気に近い盲目的な信念。"
        },
        {
            "LineId": 41,
            "SpeakerName": "",
            "Text": "資本と権力ですべてを支配できると信じていた役員たちは、億の金を差し出してでも死地へと歩み出ていく、この制御不能の「怪物」を前に、初めて冷ややかな悪寒を覚えた。"
        },
        {
            "LineId": 42,
            "SpeakerName": "キム専務",
            "Text": "(震える声で喚き散らす)ああ、出て行け!出て行って、業界の底辺でどう踏み潰されて生き埋めにされるか、しっかり見せてやるからな!!"
        },
        {
            "LineId": 43,
            "SpeakerName": "P",
            "Text": "(会議室の扉を開けながら、冷ややかに呟く)外で野垂れ死のうが、地獄に堕ちて悪魔に魂を売ろうが——俺の勝手だ。"
        },
        {
            "LineId": 44,
            "SpeakerName": "",
            "Text": "その物騒な一言を最後に、Pは未練なく鉄の扉を後にする。"
        },
        {
            "LineId": 45,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 46,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 47,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 48,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 49,
            "SpeakerName": "",
            "Text": "ウィィィン——"
        },
        {
            "LineId": 50,
            "SpeakerName": "",
            "Text": "再び戻ってきた、真っ白な地下練習室。"
        },
        {
            "LineId": 51,
            "SpeakerName": "",
            "Text": "子どもたちはPが戻るまで身動きひとつできず、床で互いを抱きしめ合ったままうずくまっていた。"
        },
        {
            "LineId": 52,
            "SpeakerName": "",
            "Text": "冷たい扉が開き、泥まみれのPが入ってくると、五人の少女の絶望的な視線が一斉に彼へと注がれる。"
        },
        {
            "LineId": 53,
            "SpeakerName": "リア",
            "Text": ""
        },
        {
            "LineId": 54,
            "SpeakerName": "",
            "Text": "Pは固まっている子どもたちへ、まっすぐに歩み寄る。"
        },
        {
            "LineId": 55,
            "SpeakerName": "",
            "Text": "そして膝を折って床に座り込むと、血が出るほど自分の太ももをつねっているリアの手を優しく引き剥がし、ジウの涙に濡れた頬を、ごつごつした手で拭う。"
        },
        {
            "LineId": 56,
            "SpeakerName": "P",
            "Text": "(世界で一番穏やかな声で)もう泣くな。"
        },
        {
            "LineId": 57,
            "SpeakerName": "ジウ",
            "Text": ""
        },
        {
            "LineId": 58,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 59,
            "SpeakerName": "ミナ",
            "Text": ""
        },
        {
            "LineId": 60,
            "SpeakerName": "",
            "Text": "誰もが息を殺し、Pの唇だけを見つめる瞬間。"
        },
        {
            "LineId": 61,
            "SpeakerName": "",
            "Text": "Pが子どもたちに向かって、温かくも揺るぎない微笑みを浮かべてみせる。"
        },
        {
            "LineId": 62,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 63,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 64,
            "SpeakerName": "ソユン",
            "Text": ""
        },
        {
            "LineId": 65,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 66,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 67,
            "SpeakerName": "",
            "Text": "その宣言は、漆黒の絶望に閉じ込められていた少女たちに降ろされた、一本の命綱であり、完全なる救いだった。"
        },
        {
            "LineId": 68,
            "SpeakerName": "",
            "Text": "抑え込まれていた子どもたちの泣き声が、一斉に堰を切る。"
        },
        {
            "LineId": 69,
            "SpeakerName": "",
            "Text": "五人の少女はPの胸へ崩れ落ちるように飛び込み、声を上げて泣きじゃくり始める。"
        },
        {
            "LineId": 70,
            "SpeakerName": "",
            "Text": "Pは雪片と泥にまみれた腕を伸ばし、自分を信じて崖っぷちから共に飛び込んでくれた五つの小さな肩を、壊れるほど強く抱きしめる。"
        },
        {
            "LineId": 71,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 72,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 73,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 74,
            "SpeakerName": "",
            "Text": ""
        }
    ]
}
