{
    "SchemaVersion": 1,
    "StoryId": "STORY_PROLOGUE_09",
    "Lines": [
        {
            "LineId": 1,
            "SpeakerName": "",
            "Text": "コツ……ズルッ、コツ……"
        },
        {
            "LineId": 2,
            "SpeakerName": "",
            "Text": "放送局の、冷たく白い大理石の廊下。"
        },
        {
            "LineId": 3,
            "SpeakerName": "",
            "Text": "ついさっきまでステージを打ち砕く勢いで舞っていた五人の少女は、今や惨めな敗残兵となって歩いている。"
        },
        {
            "LineId": 4,
            "SpeakerName": "",
            "Text": "足首の腫れ上がったジウを、リアとハナが両側から懸命に支える。"
        },
        {
            "LineId": 5,
            "SpeakerName": "",
            "Text": "膝が擦り剥け血の流れるソユンは、魂の抜けたような焦点のない瞳で、虚空だけを見て歩く。"
        },
        {
            "LineId": 6,
            "SpeakerName": "",
            "Text": "テープを巻いていたミナの足首にも赤い血が滲み出し、大理石の床に点々と染みを残していく。"
        },
        {
            "LineId": 7,
            "SpeakerName": "",
            "Text": "廊下の向こうからは、彼女たちを追い出して上がった次のチームの軽快な音楽と観客の歓声が、幻聴のように響いていた。"
        },
        {
            "LineId": 8,
            "SpeakerName": "",
            "Text": "その重い絶望の行列の先頭で、Pは血が出るほど唇を噛みしめながら、電話に向かって喚いていた。"
        },
        {
            "LineId": 9,
            "SpeakerName": "P",
            "Text": "補償?局長、ふざけてるんですか!?子どもたちが怪我をしたんですよ!"
        },
        {
            "LineId": 10,
            "SpeakerName": "P",
            "Text": "音楽が途切れても生の声で歌い続けていた子たちを、スタッフが荷物みたいに放り投げたんです!!"
        },
        {
            "LineId": 11,
            "SpeakerName": "局長",
            "Text": "(電話越し)やれやれ、P君。話の分からん人だな。"
        },
        {
            "LineId": 12,
            "SpeakerName": "局長",
            "Text": "(電話越し)だから、違約金を倍にして振り込んでやると言ってるだろう。"
        },
        {
            "LineId": 13,
            "SpeakerName": "局長",
            "Text": "(電話越し)S-Tierがラインナップを全部引き上げると言うんだ、私にどうしろと?放送局を畳めとでも?"
        },
        {
            "LineId": 14,
            "SpeakerName": "P",
            "Text": "金の問題じゃないでしょう!!あの3分30秒を準備するために、あの子たちがどれだけ……"
        },
        {
            "LineId": 15,
            "SpeakerName": "局長",
            "Text": "(電話越し)P君。ロマンを語ってないで、現実を見なさい。誰があんなゴミ事務所の子たちのダンスを観たがるんだ?"
        },
        {
            "LineId": 16,
            "SpeakerName": "局長",
            "Text": "(電話越し)どうせ視聴率を喰う穴埋めだったんだよ。可哀想だから拾ってやったのに……とんだ飛び火を食らったもんだ。"
        },
        {
            "LineId": 17,
            "SpeakerName": "局長",
            "Text": "(電話越し)金をくれてやると言ってるうちに、大人しく消えなさい。"
        },
        {
            "LineId": 18,
            "SpeakerName": "",
            "Text": "ツー、ツー、ツー——"
        },
        {
            "LineId": 19,
            "SpeakerName": "",
            "Text": "一方的に切られた電話。"
        },
        {
            "LineId": 20,
            "SpeakerName": "",
            "Text": "Pは液晶の砕けたスマートフォンを握りしめたまま、冷たい廊下の壁に額を打ちつける。"
        },
        {
            "LineId": 21,
            "SpeakerName": "",
            "Text": "ゴミ事務所。視聴率を喰う穴埋め。"
        },
        {
            "LineId": 22,
            "SpeakerName": "",
            "Text": "骨を削って作り上げた彼らの奇跡も、あの堅牢な資本の城壁の内側では——札束を数枚握らせれば片付く汚物としてしか、扱われていなかった。"
        },
        {
            "LineId": 23,
            "SpeakerName": "",
            "Text": "その時だった。"
        },
        {
            "LineId": 24,
            "SpeakerName": "",
            "Text": "凄惨な静寂を破り、廊下の向こうから、軽快で傲慢な靴音が聞こえてくる。"
        },
        {
            "LineId": 25,
            "SpeakerName": "",
            "Text": "コツッ、コツッ、コツッ。"
        },
        {
            "LineId": 26,
            "SpeakerName": "",
            "Text": "最高級サロンで仕上げた完璧なヘアスタイル、目も眩むほど輝くステージ衣装とダイヤモンドのアクセサリー。"
        },
        {
            "LineId": 27,
            "SpeakerName": "",
            "Text": "大勢のスタッフとマネージャーの鉄壁の護衛を受けながら廊下を歩いてくるのは、現在、韓国で最も売れているS-Tierの看板ガールズグループだった。"
        },
        {
            "LineId": 28,
            "SpeakerName": "",
            "Text": "そしてその華やかな行列の先頭を、余裕の微笑みを湛えたジュヒが歩いている。"
        },
        {
            "LineId": 29,
            "SpeakerName": "",
            "Text": "ジュヒの登場に、放心していた子どもたちの身体が硬直する。"
        },
        {
            "LineId": 30,
            "SpeakerName": "",
            "Text": "最高級の香水の匂いが、汗と血と地下室のカビの匂いの混じった子どもたちの空気を、暴力的に塗り潰す。"
        },
        {
            "LineId": 31,
            "SpeakerName": "",
            "Text": "S-Tierのアイドルたちは、土埃を被ったジウとミナを見て、汚いものでも見たかのように鼻をつまみ、くすくすと笑い合う。"
        },
        {
            "LineId": 32,
            "SpeakerName": "アイドル1",
            "Text": "(マネージャーの後ろに隠れ、露骨に顔をしかめる)ちょっと、あの子たち何?血の匂いがする。放送局って、物乞いも入れるんだ?"
        },
        {
            "LineId": 33,
            "SpeakerName": "アイドル2",
            "Text": "ああ、この前捨てられたっていう、例の不良品じゃない?見たことある気がする。"
        },
        {
            "LineId": 34,
            "SpeakerName": "アイドル2",
            "Text": "ほんと、しつこくどこまで這い上がってくる気なんだか。"
        },
        {
            "LineId": 35,
            "SpeakerName": "",
            "Text": "少女たちは、何ひとつ言い返せなかった。"
        },
        {
            "LineId": 36,
            "SpeakerName": "",
            "Text": "ミナはただ深くうつむいたまま、血が出るほど唇を噛みしめ、ソユンの空っぽの両目からは、声のない涙だけがぽたぽたと落ちていく。"
        },
        {
            "LineId": 37,
            "SpeakerName": "",
            "Text": "ジウは痛む足首を押さえたまま口を塞ぎ、ハナは息の音さえ立てられず、ただ震えていた。"
        },
        {
            "LineId": 38,
            "SpeakerName": "",
            "Text": "そのあからさまな嘲りに、リアの瞳に殺気が宿る。"
        },
        {
            "LineId": 39,
            "SpeakerName": "",
            "Text": "リアが今にも飛びかからんばかりに拳を握るが、Pが慌てて腕を伸ばし、リアを制する。"
        },
        {
            "LineId": 40,
            "SpeakerName": "",
            "Text": "ここで彼らと揉めたところで、傷つくのは力のない子どもたちだけだった。"
        },
        {
            "LineId": 41,
            "SpeakerName": "P",
            "Text": "(怒りを押し殺し、低く)どけ、カン・ジュヒ。"
        },
        {
            "LineId": 42,
            "SpeakerName": "ジュヒ",
            "Text": "(同情心たっぷりの、反吐の出るような微笑みを浮かべて)ほらね、P。私の隣で大人しくしてなさいって言ったでしょう。"
        },
        {
            "LineId": 43,
            "SpeakerName": "ジュヒ",
            "Text": "身の程知らずに飛び出した代償が——たったの、これ?"
        },
        {
            "LineId": 44,
            "SpeakerName": "ジュヒ",
            "Text": "(黙ってうなだれる子どもたちを冷たく見下ろし、舌を打つ)あんたたちも本当に哀れね。Pのあの浅ましいヒーローごっこに振り回されて、あのカビ臭い地下室で腐っていくだなんて。"
        },
        {
            "LineId": 45,
            "SpeakerName": "ジュヒ",
            "Text": "ご覧なさい。あんたたちのご立派な盾があんなふうに踏みにじられて頭を下げている間、私の子たちはあの眩しいスポットライトを浴びて歩いているのよ。"
        },
        {
            "LineId": 46,
            "SpeakerName": "",
            "Text": "ジュヒの言葉は、あまりに鋭い真実で、反論すらできなかった。"
        },
        {
            "LineId": 47,
            "SpeakerName": "",
            "Text": "ついさっき、スタッフに蹴り倒され、ズボンの裾が裂け、靴の壊れたPの惨めな姿と、スタッフに護衛されるジュヒの姿は——あまりにも残酷な対比を成していた。"
        },
        {
            "LineId": 48,
            "SpeakerName": "ジュヒ",
            "Text": "P、違約金の名目でいくらか振り込んでおいたから、それで子どもたちの治療費にでもしなさい。"
        },
        {
            "LineId": 49,
            "SpeakerName": "ジュヒ",
            "Text": "そして二度と、うちの子たちのステージの周りをうろつかないで。"
        },
        {
            "LineId": 50,
            "SpeakerName": "",
            "Text": "ジュヒは優雅に髪をかき上げ、未練なく踵を返す。"
        },
        {
            "LineId": 51,
            "SpeakerName": "",
            "Text": "彼女の華やかなアイドルたちが、嘲笑を残してその後に続く。"
        },
        {
            "LineId": 52,
            "SpeakerName": "",
            "Text": "スポットライトの降り注ぐ燦然たるステージへと歩いていく巨大な捕食者たちの後ろ姿が完全に消えるまで、"
        },
        {
            "LineId": 53,
            "SpeakerName": "",
            "Text": "Pと子どもたちは亡霊のように、その場に凍りついていた。"
        },
        {
            "LineId": 54,
            "SpeakerName": "",
            "Text": "放送局の隅、名札すら貼られていない狭い共用の控室。"
        },
        {
            "LineId": 55,
            "SpeakerName": "",
            "Text": "Pが扉を開けて入ると、支えられながら入ってきた五人の少女が、暗い控室のソファへ力なく崩れ落ちる。"
        },
        {
            "LineId": 56,
            "SpeakerName": "",
            "Text": "誰も、口を開かなかった。"
        },
        {
            "LineId": 57,
            "SpeakerName": "",
            "Text": "慰めの言葉すらかけられないほど重い絶望が、部屋を押し潰していた。"
        },
        {
            "LineId": 58,
            "SpeakerName": "",
            "Text": "沈黙だけが漂う控室の中、唯一点いているのは、壁掛けのテレビだけ。"
        },
        {
            "LineId": 59,
            "SpeakerName": "MC",
            "Text": "(TV音声)さあ、次のステージは、皆さんが一番お待ちかねの主役たちです!S-Tierの……!!"
        },
        {
            "LineId": 60,
            "SpeakerName": "",
            "Text": "テレビ画面の中の生放送。"
        },
        {
            "LineId": 61,
            "SpeakerName": "",
            "Text": "ついさっき、子どもたちが荷物のように引きずり下ろされた、まさにあのメインステージ。"
        },
        {
            "LineId": 62,
            "SpeakerName": "",
            "Text": "その上で、先ほど廊下ですれ違ったS-Tierのアイドルたちが、華やかな特殊効果と眩い照明を浴びて踊っている。"
        },
        {
            "LineId": 63,
            "SpeakerName": "",
            "Text": "客席は彼女たちの名前を連呼し、熱狂の坩堝と化していた。"
        },
        {
            "LineId": 64,
            "SpeakerName": "",
            "Text": "資本が作り出した、最も完璧で燦然たる楽園。"
        },
        {
            "LineId": 65,
            "SpeakerName": "",
            "Text": "そして、その楽園から徹底的に追放されたまま、暗い控室のソファに座り、血の滲む膝を抱えて画面をぼんやりと見上げる、五人の透明人間たち。"
        },
        {
            "LineId": 66,
            "SpeakerName": "",
            "Text": "テレビから溢れる眩い光が、魂の抜けた子どもたちの空っぽの瞳を、残酷に照らし出していた。"
        },
        {
            "LineId": 67,
            "SpeakerName": "",
            "Text": "この世界のどんな努力をもってしても、あの巨大な暴力には勝てないのだと——彼ら全員が骨身に沁みて思い知った、夜だった。"
        }
    ]
}
