{
    "SchemaVersion": 1,
    "StoryId": "STORY_PROLOGUE_07",
    "Lines": [
        {
            "LineId": 1,
            "SpeakerName": "",
            "Text": "ギギギッ——ガンッ。"
        },
        {
            "LineId": 2,
            "SpeakerName": "",
            "Text": "重い鉄扉が軋みながら開く音に、床に倒れ込んで荒い息をついていた五人の少女の顔が、一斉に扉の方へ向く。"
        },
        {
            "LineId": 3,
            "SpeakerName": "",
            "Text": "そこに、Pが立っていた。"
        },
        {
            "LineId": 4,
            "SpeakerName": "リア",
            "Text": ""
        },
        {
            "LineId": 5,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 6,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 7,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 8,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 9,
            "SpeakerName": "ジウ",
            "Text": ""
        },
        {
            "LineId": 10,
            "SpeakerName": "ミナ",
            "Text": ""
        },
        {
            "LineId": 11,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 12,
            "SpeakerName": "",
            "Text": "子どもたちの動きが、ぴたりと止まる。"
        },
        {
            "LineId": 13,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 14,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 15,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 16,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 17,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 18,
            "SpeakerName": "ソユン",
            "Text": ""
        },
        {
            "LineId": 19,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 20,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 21,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 22,
            "SpeakerName": "",
            "Text": "Pの声は、次第に涙に濡れていった。"
        },
        {
            "LineId": 23,
            "SpeakerName": "P",
            "Text": "お前たち、デビューするんだ。"
        },
        {
            "LineId": 24,
            "SpeakerName": "",
            "Text": "その一言に、張り詰めていた子どもたちの緊張の糸が、嘘のようにぷつりと切れる。"
        },
        {
            "LineId": 25,
            "SpeakerName": "ハナ",
            "Text": ""
        },
        {
            "LineId": 26,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 27,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 28,
            "SpeakerName": "",
            "Text": "ソユンまでもが両手で顔を覆って肩を震わせ、リアはPの服の裾を握りしめたまま、子どものように涙を溢れさせた。"
        },
        {
            "LineId": 29,
            "SpeakerName": "ミナ",
            "Text": ""
        },
        {
            "LineId": 30,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 31,
            "SpeakerName": "ミナ",
            "Text": ""
        },
        {
            "LineId": 32,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 33,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 34,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 35,
            "SpeakerName": "",
            "Text": "なぜPが血まみれになってまで、このたった一度の生放送に命を懸けたのか。"
        },
        {
            "LineId": 36,
            "SpeakerName": "",
            "Text": "子どもたちの瞳に、単なる感激を超えた、猛々しい闘志が満ち始める。"
        },
        {
            "LineId": 37,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 38,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 39,
            "SpeakerName": "ソユン",
            "Text": ""
        },
        {
            "LineId": 40,
            "SpeakerName": "ミナ",
            "Text": "(足の甲に落ちた涙を荒々しく拭い、立ち上がる)S-Tierの役員ども、生放送を観ながら腰を抜かして、立てなくしてやるんだから。"
        },
        {
            "LineId": 41,
            "SpeakerName": "",
            "Text": "五人の少女と泥まみれのPは、地下室の床で抱き合い、奇跡の温もりを分かち合った。"
        },
        {
            "LineId": 42,
            "SpeakerName": "",
            "Text": "その日から、地下室は文字通り、限界を超えた凄絶な戦場と化した。"
        },
        {
            "LineId": 43,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 44,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 45,
            "SpeakerName": "ミナ",
            "Text": "ちょっと!今の交差の時、重心が浮いたでしょ!"
        },
        {
            "LineId": 46,
            "SpeakerName": "ソユン",
            "Text": ""
        },
        {
            "LineId": 47,
            "SpeakerName": "ソユン",
            "Text": ""
        },
        {
            "LineId": 48,
            "SpeakerName": "リア",
            "Text": "分かってる!(ゴホッゴホッ)喉から血が出ても音程は揺らさないから、心配しないで!"
        },
        {
            "LineId": 49,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 50,
            "SpeakerName": "",
            "Text": "一日カップラーメン一つで持ちこたえる痩せた身体でありながら、数日後、数百万人の脳裏に永遠に刻まれることになる彼女たちのダンスは、骨が折れそうなほど激しく、完璧だった。"
        },
        {
            "LineId": 51,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 52,
            "SpeakerName": "",
            "Text": "床に擦れたソユンの膝からは血が滲み出て白い練習着を赤く染め、完璧なターンにこだわり続けたミナの足の親指の爪は真っ黒に死に、ついに剥がれ落ちた。"
        },
        {
            "LineId": 53,
            "SpeakerName": "",
            "Text": "だがミナは悲鳴ひとつ上げず、震える手で傷ついた素足にガムテープを荒々しくぐるぐると巻きつけ、再び鏡の前に立った。"
        },
        {
            "LineId": 54,
            "SpeakerName": "",
            "Text": "いつも後ろに隠れていたハナまでもが、血の滲む唇を噛みしめながら、鏡の中の仮想のメインカメラを睨みつけ、毒気を帯びたラップを吐き出した。"
        },
        {
            "LineId": 55,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 56,
            "SpeakerName": "",
            "Text": "この刹那のステージに、彼らのすべてが懸かっていた。"
        },
        {
            "LineId": 57,
            "SpeakerName": "",
            "Text": "彼らは進んでこの最後の炎に、自らの骨と肉と、そして魂を、余すことなく焚べていた。"
        }
    ]
}
