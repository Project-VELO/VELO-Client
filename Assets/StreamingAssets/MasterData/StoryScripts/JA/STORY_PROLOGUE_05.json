{
    "SchemaVersion": 1,
    "StoryId": "STORY_PROLOGUE_05",
    "Lines": [
        {
            "LineId": 1,
            "SpeakerName": "P(モノローグ)",
            "Text": "自分のすべてを売り渡した代償に手に入れた、最後の機会だった。"
        },
        {
            "LineId": 2,
            "SpeakerName": "リア",
            "Text": "カビなんて、塗って隠せばいいじゃないですか。わたしたち、ここからまた始めましょう。"
        },
        {
            "LineId": 3,
            "SpeakerName": "ジウ",
            "Text": "えへへ、みんなで食べるとカップラーメンも本当においしいですね! デビューしたら焼肉おごってください!"
        },
        {
            "LineId": 4,
            "SpeakerName": "放送局PD",
            "Text": "ああ、はい。V.E.L.O? その……机に置いていってください。聴くだけは聴きますので。"
        },
        {
            "LineId": 5,
            "SpeakerName": "P(モノローグ)",
            "Text": "あの薄っぺらな厚意さえ、僕たちには許されなかった。"
        },
        {
            "LineId": 6,
            "SpeakerName": "P(モノローグ)",
            "Text": "夢を担保に借りた時間の利子は、想像を絶するほど過酷だった。"
        },
        {
            "LineId": 7,
            "SpeakerName": "P(モノローグ)",
            "Text": "最も寒く、暗い夜。僕は……この子たちを守り抜けるのだろうか。"
        }
    ]
}
