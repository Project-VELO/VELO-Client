{
    "SchemaVersion": 1,
    "StoryId": "STORY_PROLOGUE_02",
    "Lines": [
        {
            "LineId": 1,
            "SpeakerName": "",
            "Text": "ガアンッ——!!"
        },
        {
            "LineId": 2,
            "SpeakerName": "",
            "Text": "重厚な鉄の扉が、破裂音を上げて開け放たれる。"
        },
        {
            "LineId": 3,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 4,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 5,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 6,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 7,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 8,
            "SpeakerName": "",
            "Text": "ネクタイの緩んだまま、獣のように喘ぎながら入ってきたPに向かって、ジュヒがテーブルの上へタブレットを放り投げる。"
        },
        {
            "LineId": 9,
            "SpeakerName": "ジュヒ",
            "Text": ""
        },
        {
            "LineId": 10,
            "SpeakerName": "P",
            "Text": "(テーブルを両手で叩きつけながら)カン・ジュヒ。"
        },
        {
            "LineId": 11,
            "SpeakerName": "P",
            "Text": "デビューを一週間後に控えた子たちを今朝潰しただけじゃ飽き足らず、違約金が4億8千?挙句の果てに、スポンサー絡みの怪文書までばら撒いたのは、お前なんだろう?"
        },
        {
            "LineId": 12,
            "SpeakerName": "ジュヒ",
            "Text": "声を落として。"
        },
        {
            "LineId": 13,
            "SpeakerName": "ジュヒ",
            "Text": "うちは規格化された人形を組み立てて売る工場なの。"
        },
        {
            "LineId": 14,
            "SpeakerName": "ジュヒ",
            "Text": "首席として初めて手がける私のプロジェクトに、あんたの匂いがべったり染みついた不良品を載せるわけにはいかないでしょう?ラインから外して入れ替えるのは、当然の手順よ。"
        },
        {
            "LineId": 15,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 16,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 17,
            "SpeakerName": "",
            "Text": "その時、ティーカップを置いたチェ常務が、慈愛に満ちた柔らかな声で口を開く。"
        },
        {
            "LineId": 18,
            "SpeakerName": "チェ常務",
            "Text": ""
        },
        {
            "LineId": 19,
            "SpeakerName": "チェ常務",
            "Text": ""
        },
        {
            "LineId": 20,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 21,
            "SpeakerName": "チェ常務",
            "Text": ""
        },
        {
            "LineId": 22,
            "SpeakerName": "チェ常務",
            "Text": ""
        },
        {
            "LineId": 23,
            "SpeakerName": "",
            "Text": "最も穏やかで優雅な口ぶりでありながら、その中身は誰よりも悪魔じみていた。"
        },
        {
            "LineId": 24,
            "SpeakerName": "",
            "Text": "あの子たちが、ただ自分の治療用の玩具として使われ、捨てられたのだという事実に、Pの頭の中は、真っ白に染め抜かれていく。"
        },
        {
            "LineId": 25,
            "SpeakerName": "キム専務",
            "Text": ""
        },
        {
            "LineId": 26,
            "SpeakerName": "キム専務",
            "Text": ""
        },
        {
            "LineId": 27,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 28,
            "SpeakerName": "キム専務",
            "Text": "(身を乗り出し、Pを嘲るように見つめながら)何だ?今度もあの女ども、借金に耐えかねて屋上から飛ぶんじゃないかとビビってんのか?おい、この前みたいなことになったら、その後始末と記事を止めるのにも全部金がかかるんだよ。"
        },
        {
            "LineId": 29,
            "SpeakerName": "キム専務",
            "Text": "首輪はしっかり握っとけ。"
        },
        {
            "LineId": 30,
            "SpeakerName": "",
            "Text": "ドクン——。"
        },
        {
            "LineId": 31,
            "SpeakerName": "",
            "Text": "数年前、屋上から宙へ身を投げた、Pの最初のアイドルの蒼白な顔が視界を覆い、息が詰まる。"
        },
        {
            "LineId": 32,
            "SpeakerName": "",
            "Text": "爪が掌に食い込み血が滲むが、黒曜石のように固く結束した資本の暴力の前では、どんな悲鳴も無力だった。"
        },
        {
            "LineId": 33,
            "SpeakerName": "",
            "Text": "ウィィィン——"
        },
        {
            "LineId": 34,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 35,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 36,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 37,
            "SpeakerName": "",
            "Text": "鏡の壁にへたり込んでいたジウが、震える手で請求書を握りしめたまま、放心状態のPを見上げる。"
        },
        {
            "LineId": 38,
            "SpeakerName": "ジウ",
            "Text": ""
        },
        {
            "LineId": 39,
            "SpeakerName": "ジウ",
            "Text": ""
        },
        {
            "LineId": 40,
            "SpeakerName": "ハナ",
            "Text": ""
        },
        {
            "LineId": 41,
            "SpeakerName": "ハナ",
            "Text": ""
        },
        {
            "LineId": 42,
            "SpeakerName": "",
            "Text": "潔癖症に近いほど気位の高かったミナは、床の埃が服につくのも忘れ、焦点を失った瞳で虚空だけを見つめている。"
        },
        {
            "LineId": 43,
            "SpeakerName": "ミナ",
            "Text": "(虚ろに笑いながら)終わったのよ。"
        },
        {
            "LineId": 44,
            "SpeakerName": "ミナ",
            "Text": "S-Tierが本気で葬った廃棄物を、誰が拾うっていうの?必死に食らいついてきた3年が、まるごとゴミ箱に捨てられたのよ。"
        },
        {
            "LineId": 45,
            "SpeakerName": "ソユン",
            "Text": ""
        },
        {
            "LineId": 46,
            "SpeakerName": "ミナ",
            "Text": ""
        },
        {
            "LineId": 47,
            "SpeakerName": "ミナ",
            "Text": ""
        },
        {
            "LineId": 48,
            "SpeakerName": "",
            "Text": "ミナの悲鳴が、がらんとした練習室を切り裂く。"
        },
        {
            "LineId": 49,
            "SpeakerName": "",
            "Text": "リアが蒼白な顔で、血が滲むほど太ももをつねりながら、みんなを抱き寄せる。"
        },
        {
            "LineId": 50,
            "SpeakerName": "リア",
            "Text": ""
        },
        {
            "LineId": 51,
            "SpeakerName": "リア",
            "Text": ""
        },
        {
            "LineId": 52,
            "SpeakerName": "",
            "Text": "誰かの「リハビリ用の玩具」として使われ、完膚なきまでに壊されてしまった子どもたち。"
        },
        {
            "LineId": 53,
            "SpeakerName": "",
            "Text": "少女たちは遭難者のように床を這って近づき、Pのズボンの裾を命綱のように固く握りしめる。"
        },
        {
            "LineId": 54,
            "SpeakerName": "ソユン",
            "Text": ""
        },
        {
            "LineId": 55,
            "SpeakerName": "ソユン",
            "Text": ""
        },
        {
            "LineId": 56,
            "SpeakerName": "ジウ",
            "Text": ""
        },
        {
            "LineId": 57,
            "SpeakerName": "リア",
            "Text": ""
        },
        {
            "LineId": 58,
            "SpeakerName": "キム専務",
            "Text": ""
        },
        {
            "LineId": 59,
            "SpeakerName": "",
            "Text": "キム専務が吐き捨てた金属質の声が、幻聴となってPの鼓膜を刺す。"
        },
        {
            "LineId": 60,
            "SpeakerName": "",
            "Text": "屠殺場に閉じ込められた仔羊のように縋りつき、泣き叫ぶ少女たち。"
        },
        {
            "LineId": 61,
            "SpeakerName": "",
            "Text": "それを見下ろしながら、Pは胸が張り裂けるような思いで、切れた唇を噛みしめる。"
        },
        {
            "LineId": 62,
            "SpeakerName": "",
            "Text": "巨大な壁にぶつかり、行き場を失った視線の下で——子どもたちの熱い涙が、古びた革靴の上へ、とめどなく降り注いでいた。"
        }
    ]
}
