    "SchemaVersion": 1,
    "StoryId": "STORY_PROLOGUE_11",
    "Lines": [
        {
            "LineId": 1,
            "SpeakerName": "P",
            "Text": "The coldest, darkest night. It felt as if tomorrow would never come for these girls."
        },
        {
            "LineId": 2,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 3,
            "SpeakerName": "P",
            "Text": "The stage we dreamed of had crashed down onto a moldy basement floor."
        },
        {
            "LineId": 4,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 5,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 6,
            "SpeakerName": "P",
            "Text": "...And then, at the very moment I was about to give up on everything."
        },
        {
            "LineId": 7,
            "SpeakerName": "",
            "Text": "“To you, whose every light has gone out: the Abyss invites you in.”"
        }
    ]
}