            "SpeakerId": "CHAR_JIWOO",
            "SpeakerName": "지우",
            "Text": "언니, 괜찮아! 근데 이거 디자인은 엄청 예쁜데?",
            "BackgroundId": "",
            "CharacterId": "",
            "ExpressionId": "",
            "CenterCharacterId": "",
            "CenterExpressionId": "",
