{
    "SchemaVersion": 1,
    "StoryId": "STORY_PROLOGUE_02",
    "Lines": [
        {
            "LineId": 1,
            "SpeakerName": "",
            "Text": "ガアンッ——!!"
        },
        {
            "LineId": 2,
            "SpeakerName": "",
            "Text": "重厚な鉄の扉が、破裂音を上げて開け放たれる。"
        },
        {
            "LineId": 3,
            "SpeakerName": "",
            "Text": "温もりなど一欠片も存在しない、殺伐とした無彩色の空間。"
        },
        {
            "LineId": 4,
            "SpeakerName": "",
            "Text": "巨大な黒曜石のテーブルを中心に、鋭い直線のフォルムの椅子が整列し、"
        },
        {
            "LineId": 5,
            "SpeakerName": "",
            "Text": "灰色の壁面を伝う冷ややかな白色照明は、まるでギロチンの刃のようだった。"
        },
        {
            "LineId": 6,
            "SpeakerName": "",
            "Text": "その息の詰まる鉄壁の上座には、今日付でPを追い落とし「首席プロデューサー」のバッジを手にしたカン・ジュヒが、脚を組んで座っていた。"
        },
        {
            "LineId": 7,
            "SpeakerName": "",
            "Text": "その右手には煙草をふかす血の気の多いキム専務が、左手には茶碗を手にしたチェ常務が、並んで座っていた。"
        },
        {
            "LineId": 8,
            "SpeakerName": "",
            "Text": "ネクタイの緩んだまま、獣のように喘ぎながら入ってきたPに向かって、ジュヒがテーブルの上へタブレットを放り投げる。"
        },
        {
            "LineId": 9,
            "SpeakerName": "ジュヒ",
            "Text": "ノックくらいしなさいよ。下品ね。"
        },
        {
            "LineId": 10,
            "SpeakerName": "P",
            "Text": "(テーブルを両手で叩きつけながら)カン・ジュヒ。"
        },
        {
            "LineId": 11,
            "SpeakerName": "P",
            "Text": "デビューを一週間後に控えた子たちを今朝潰しただけじゃ飽き足らず、違約金が4億8千?挙句の果てに、スポンサー絡みの怪文書までばら撒いたのは、お前なんだろう?"
        },
        {
            "LineId": 12,
            "SpeakerName": "ジュヒ",
            "Text": "声を落として。"
        },
        {
            "LineId": 13,
            "SpeakerName": "ジュヒ",
            "Text": "うちは規格化された人形を組み立てて売る工場なの。"
        },
        {
            "LineId": 14,
            "SpeakerName": "ジュヒ",
            "Text": "首席として初めて手がける私のプロジェクトに、あんたの匂いがべったり染みついた不良品を載せるわけにはいかないでしょう?ラインから外して入れ替えるのは、当然の手順よ。"
        },
        {
            "LineId": 15,
            "SpeakerName": "P",
            "Text": "不良品だと!?過去に囚われて息もできずにいた俺に、無理やりあの子たちを押し付けたのはあんたたちだろうが!"
        },
        {
            "LineId": 16,
            "SpeakerName": "P",
            "Text": "3年間、あの子たちの爪が剥がれるほど磨き上げてきたのに、今さら廃棄するだと!?"
        },
        {
            "LineId": 17,
            "SpeakerName": "",
            "Text": "その時、ティーカップを置いたチェ常務が、慈愛に満ちた柔らかな声で口を開く。"
        },
        {
            "LineId": 18,
            "SpeakerName": "チェ常務",
            "Text": "P君。何か大きな誤解をしているようだね。"
        },
        {
            "LineId": 19,
            "SpeakerName": "チェ常務",
            "Text": "我々が3年前、あの痛ましい屋上の事故以来、壊れてしまっていた君にあの子たちを任せたのは……いわば「リハビリ用の玩具」だったんだよ。"
        },
        {
            "LineId": 20,
            "SpeakerName": "P",
            "Text": "……何だと?"
        },
        {
            "LineId": 21,
            "SpeakerName": "チェ常務",
            "Text": "我がS-Tierには、君のような天才プロデューサーが必要だからね。傷が膿む前に、ままごとでもしながら癒えるようにという配慮だったのさ。"
        },
        {
            "LineId": 22,
            "SpeakerName": "チェ常務",
            "Text": "もう立派に克服できたのだから、役目を終えた玩具は片付けるのが筋というものじゃないかね?"
        },
        {
            "LineId": 23,
            "SpeakerName": "",
            "Text": "最も穏やかで優雅な口ぶりでありながら、その中身は誰よりも悪魔じみていた。"
        },
        {
            "LineId": 24,
            "SpeakerName": "",
            "Text": "あの子たちが、ただ自分の治療用の玩具として使われ、捨てられたのだという事実に、Pの頭の中は、真っ白に染め抜かれていく。"
        },
        {
            "LineId": 25,
            "SpeakerName": "キム専務",
            "Text": "(灰皿に煙草を荒々しく揉み消しながら)おい、P。お前の才能だけは会長も認めてるから、俺たちもここまで我慢してやったんだ。"
        },
        {
            "LineId": 26,
            "SpeakerName": "キム専務",
            "Text": "だから前みたいに黙って見なかったフリをしろ。どうせ数日前、投資家の接待の席で大人しく酌のひとつもせず、場をぶち壊した女どもだろうが。"
        },
        {
            "LineId": 27,
            "SpeakerName": "P",
            "Text": "この悪魔どもが……"
        },
        {
            "LineId": 28,
            "SpeakerName": "キム専務",
            "Text": "(身を乗り出し、Pを嘲るように見つめながら)何だ?今度もあの女ども、借金に耐えかねて屋上から飛ぶんじゃないかとビビってんのか?おい、この前みたいなことになったら、その後始末と記事を止めるのにも全部金がかかるんだよ。"
        },
        {
            "LineId": 29,
            "SpeakerName": "キム専務",
            "Text": "首輪はしっかり握っとけ。"
        },
        {
            "LineId": 30,
            "SpeakerName": "",
            "Text": "ドクン——。"
        },
        {
            "LineId": 31,
            "SpeakerName": "",
            "Text": "数年前、屋上から宙へ身を投げた、Pの最初のアイドルの蒼白な顔が視界を覆い、息が詰まる。"
        },
        {
            "LineId": 32,
            "SpeakerName": "",
            "Text": "爪が掌に食い込み血が滲むが、黒曜石のように固く結束した資本の暴力の前では、どんな悲鳴も無力だった。"
        },
        {
            "LineId": 33,
            "SpeakerName": "",
            "Text": "ウィィィン——"
        },
        {
            "LineId": 34,
            "SpeakerName": "",
            "Text": "地獄から逃げるように降りてきた地下1階。埃ひとつ許さない空気清浄機のモーター音だけが重く漂う、真っ白な空間。"
        },
        {
            "LineId": 35,
            "SpeakerName": "",
            "Text": "精肉店のショーケースさながらに、冷たく凍てついた白色LEDの光が容赦なく降り注ぐ床板の上には、"
        },
        {
            "LineId": 36,
            "SpeakerName": "",
            "Text": "[契約解除および損害賠償請求書]がおぞましく転がっている。"
        },
        {
            "LineId": 37,
            "SpeakerName": "",
            "Text": "鏡の壁にへたり込んでいたジウが、震える手で請求書を握りしめたまま、放心状態のPを見上げる。"
        },
        {
            "LineId": 38,
            "SpeakerName": "ジウ",
            "Text": "P……これ、本当なんですか?4億8千って……"
        },
        {
            "LineId": 39,
            "SpeakerName": "ジウ",
            "Text": "うちのお母さんのトッポッキ屋の保証金、3千万ウォンなのに……私たち、ただ踊って歌ってただけなのに、どうしてこんなことに……?"
        },
        {
            "LineId": 40,
            "SpeakerName": "ハナ",
            "Text": "(耳を塞いだまま、うわ言のように)怪文書、もう出回ってるんだって……裏でスポンサーに身体を売ってる子たちだって。"
        },
        {
            "LineId": 41,
            "SpeakerName": "ハナ",
            "Text": "この地下で3年間、死に物狂いで練習してただけなのに……どうしてみんな、私たちをゴミだなんて……うぅっ……"
        },
        {
            "LineId": 42,
            "SpeakerName": "",
            "Text": "潔癖症に近いほど気位の高かったミナは、床の埃が服につくのも忘れ、焦点を失った瞳で虚空だけを見つめている。"
        },
        {
            "LineId": 43,
            "SpeakerName": "ミナ",
            "Text": "(虚ろに笑いながら)終わったのよ。"
        },
        {
            "LineId": 44,
            "SpeakerName": "ミナ",
            "Text": "S-Tierが本気で葬った廃棄物を、誰が拾うっていうの?必死に食らいついてきた3年が、まるごとゴミ箱に捨てられたのよ。"
        },
        {
            "LineId": 45,
            "SpeakerName": "ソユン",
            "Text": "(懸命に笑おうとするが、涙が止まらない)ミナ、そんなこと言わないで。Pが上の階に行ってきてくれたじゃない。何とかして……"
        },
        {
            "LineId": 46,
            "SpeakerName": "ミナ",
            "Text": "(声を張り上げて)何をどう解決するのよ!!"
        },
        {
            "LineId": 47,
            "SpeakerName": "ミナ",
            "Text": "役員たちが本気で仕組んだ盤面なのに、一介のプロデューサーに何の力があって、借金を防いで私たちを守れるっていうの!!"
        },
        {
            "LineId": 48,
            "SpeakerName": "",
            "Text": "ミナの悲鳴が、がらんとした練習室を切り裂く。"
        },
        {
            "LineId": 49,
            "SpeakerName": "",
            "Text": "リアが蒼白な顔で、血が滲むほど太ももをつねりながら、みんなを抱き寄せる。"
        },
        {
            "LineId": 50,
            "SpeakerName": "リア",
            "Text": "みんな、もうやめて……私がリーダーだから、ジュヒプロデューサーのところへ行って、土下座でも何でもする。"
        },
        {
            "LineId": 51,
            "SpeakerName": "リア",
            "Text": "言われた通り全部やるから、一度だけ助けてくださいって縋るから。お願い……"
        },
        {
            "LineId": 52,
            "SpeakerName": "",
            "Text": "誰かの「リハビリ用の玩具」として使われ、完膚なきまでに壊されてしまった子どもたち。"
        },
        {
            "LineId": 53,
            "SpeakerName": "",
            "Text": "少女たちは遭難者のように床を這って近づき、Pのズボンの裾を命綱のように固く握りしめる。"
        },
        {
            "LineId": 54,
            "SpeakerName": "ソユン",
            "Text": "(握った手に血が通わなくなるほど力を込めながら)P……私たち、本当に何もしてない。"
        },
        {
            "LineId": 55,
            "SpeakerName": "ソユン",
            "Text": "接待の席で大人しくしなかったからって……あの人形みたいな真似だけはしないって踏みとどまったことが、どうして4億の値がつく死罪になるの……?"
        },
        {
            "LineId": 56,
            "SpeakerName": "ジウ",
            "Text": "(Pの脚をぎゅっと抱きしめ、泣き崩れる)助けてください、P……この借金を抱えて、お母さんにどんな顔をして会えばいいんですか……"
        },
        {
            "LineId": 57,
            "SpeakerName": "リア",
            "Text": "(涙でぐしゃぐしゃになったまま懇願する)私たち、このままじゃ終われません。Pが3年間かけて磨き上げてくれた私たちのステージに、一度だけでいいから立たせてください。お願いします……"
        },
        {
            "LineId": 58,
            "SpeakerName": "キム専務",
            "Text": "(幻聴)なんだ?前みたいに屋上から飛び降りるんじゃないかって怖いのか?見なかったフリをしろ。"
        },
        {
            "LineId": 59,
            "SpeakerName": "",
            "Text": "キム専務が吐き捨てた金属質の声が、幻聴となってPの鼓膜を刺す。"
        },
        {
            "LineId": 60,
            "SpeakerName": "",
            "Text": "屠殺場に閉じ込められた仔羊のように縋りつき、泣き叫ぶ少女たち。"
        },
        {
            "LineId": 61,
            "SpeakerName": "",
            "Text": "それを見下ろしながら、Pは胸が張り裂けるような思いで、切れた唇を噛みしめる。"
        },
        {
            "LineId": 62,
            "SpeakerName": "",
            "Text": "巨大な壁にぶつかり、行き場を失った視線の下で——子どもたちの熱い涙が、古びた革靴の上へ、とめどなく降り注いでいた。"
        }
    ]
}
