{
    "SchemaVersion": 1,
    "StoryId": "STORY_PROLOGUE_09",
    "Lines": [
        {
            "LineId": 1,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 2,
            "SpeakerName": "",
            "Text": "放送局の、冷たく白い大理石の廊下。"
        },
        {
            "LineId": 3,
            "SpeakerName": "",
            "Text": "ついさっきまでステージを打ち砕く勢いで舞っていた五人の少女は、今や惨めな敗残兵となって歩いている。"
        },
        {
            "LineId": 4,
            "SpeakerName": "",
            "Text": "足首の腫れ上がったジウを、リアとハナが両側から懸命に支える。"
        },
        {
            "LineId": 5,
            "SpeakerName": "",
            "Text": "膝が擦り剥け血の流れるソユンは、魂の抜けたような焦点のない瞳で、虚空だけを見て歩く。"
        },
        {
            "LineId": 6,
            "SpeakerName": "",
            "Text": "テープを巻いていたミナの足首にも赤い血が滲み出し、大理石の床に点々と染みを残していく。"
        },
        {
            "LineId": 7,
            "SpeakerName": "",
            "Text": "廊下の向こうからは、彼女たちを追い出して上がった次のチームの軽快な音楽と観客の歓声が、幻聴のように響いていた。"
        },
        {
            "LineId": 8,
            "SpeakerName": "",
            "Text": "その重い絶望の行列の先頭で、Pは血が出るほど唇を噛みしめながら、電話に向かって喚いていた。"
        },
        {
            "LineId": 9,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 10,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 11,
            "SpeakerName": "局長",
            "Text": ""
        },
        {
            "LineId": 12,
            "SpeakerName": "局長",
            "Text": ""
        },
        {
            "LineId": 13,
            "SpeakerName": "局長",
            "Text": ""
        },
        {
            "LineId": 14,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 15,
            "SpeakerName": "局長",
            "Text": ""
        },
        {
            "LineId": 16,
            "SpeakerName": "局長",
            "Text": ""
        },
        {
            "LineId": 17,
            "SpeakerName": "局長",
            "Text": ""
        },
        {
            "LineId": 18,
            "SpeakerName": "",
            "Text": "ツー、ツー、ツー——"
        },
        {
            "LineId": 19,
            "SpeakerName": "",
            "Text": "一方的に切られた電話。"
        },
        {
            "LineId": 20,
            "SpeakerName": "",
            "Text": "Pは液晶の砕けたスマートフォンを握りしめたまま、冷たい廊下の壁に額を打ちつける。"
        },
        {
            "LineId": 21,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 22,
            "SpeakerName": "",
            "Text": "骨を削って作り上げた彼らの奇跡も、あの堅牢な資本の城壁の内側では——札束を数枚握らせれば片付く汚物としてしか、扱われていなかった。"
        },
        {
            "LineId": 23,
            "SpeakerName": "",
            "Text": "その時だった。"
        },
        {
            "LineId": 24,
            "SpeakerName": "",
            "Text": "凄惨な静寂を破り、廊下の向こうから、軽快で傲慢な靴音が聞こえてくる。"
        },
        {
            "LineId": 25,
            "SpeakerName": "",
            "Text": "コツッ、コツッ、コツッ。"
        },
        {
            "LineId": 26,
            "SpeakerName": "",
            "Text": "最高級サロンで仕上げた完璧なヘアスタイル、目も眩むほど輝くステージ衣装とダイヤモンドのアクセサリー。"
        },
        {
            "LineId": 27,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 28,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 29,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 30,
            "SpeakerName": "",
            "Text": "最高級の香水の匂いが、汗と血と地下室のカビの匂いの混じった子どもたちの空気を、暴力的に塗り潰す。"
        },
        {
            "LineId": 31,
            "SpeakerName": "",
            "Text": "S-Tierのアイドルたちは、土埃を被ったジウとミナを見て、汚いものでも見たかのように鼻をつまみ、くすくすと笑い合う。"
        },
        {
            "LineId": 32,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 33,
            "SpeakerName": "",
            "Text": "ああ、この前捨てられたっていう、例の不良品じゃない?見たことある気がする。"
        },
        {
            "LineId": 34,
            "SpeakerName": "",
            "Text": "ほんと、しつこくどこまで這い上がってくる気なんだか。"
        },
        {
            "LineId": 35,
            "SpeakerName": "",
            "Text": "少女たちは、何ひとつ言い返せなかった。"
        },
        {
            "LineId": 36,
            "SpeakerName": "",
            "Text": "ミナはただ深くうつむいたまま、血が出るほど唇を噛みしめ、ソユンの空っぽの両目からは、声のない涙だけがぽたぽたと落ちていく。"
        },
        {
            "LineId": 37,
            "SpeakerName": "",
            "Text": "ジウは痛む足首を押さえたまま口を塞ぎ、ハナは息の音さえ立てられず、ただ震えていた。"
        },
        {
            "LineId": 38,
            "SpeakerName": "",
            "Text": "そのあからさまな嘲りに、リアの瞳に殺気が宿る。"
        },
        {
            "LineId": 39,
            "SpeakerName": "",
            "Text": "リアが今にも飛びかからんばかりに拳を握るが、Pが慌てて腕を伸ばし、リアを制する。"
        },
        {
            "LineId": 40,
            "SpeakerName": "",
            "Text": "ここで彼らと揉めたところで、傷つくのは力のない子どもたちだけだった。"
        },
        {
            "LineId": 41,
            "SpeakerName": "P",
            "Text": "(怒りを押し殺し、低く)どけ、カン・ジュヒ。"
        },
        {
            "LineId": 42,
            "SpeakerName": "ジュヒ",
            "Text": ""
        },
        {
            "LineId": 43,
            "SpeakerName": "ジュヒ",
            "Text": ""
        },
        {
            "LineId": 44,
            "SpeakerName": "ジュヒ",
            "Text": ""
        },
        {
            "LineId": 45,
            "SpeakerName": "ジュヒ",
            "Text": ""
        },
        {
            "LineId": 46,
            "SpeakerName": "",
            "Text": "ジュヒの言葉は、あまりに鋭い真実で、反論すらできなかった。"
        },
        {
            "LineId": 47,
            "SpeakerName": "",
            "Text": "ついさっき、スタッフに蹴り倒され、ズボンの裾が裂け、靴の壊れたPの惨めな姿と、スタッフに護衛されるジュヒの姿は——あまりにも残酷な対比を成していた。"
        },
        {
            "LineId": 48,
            "SpeakerName": "ジュヒ",
            "Text": "P、違約金の名目でいくらか振り込んでおいたから、それで子どもたちの治療費にでもしなさい。"
        },
        {
            "LineId": 49,
            "SpeakerName": "ジュヒ",
            "Text": "そして二度と、うちの子たちのステージの周りをうろつかないで。"
        },
        {
            "LineId": 50,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 51,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 52,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 53,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 54,
            "SpeakerName": "",
            "Text": "放送局の隅、名札すら貼られていない狭い共用の控室。"
        },
        {
            "LineId": 55,
            "SpeakerName": "",
            "Text": "Pが扉を開けて入ると、支えられながら入ってきた五人の少女が、暗い控室のソファへ力なく崩れ落ちる。"
        },
        {
            "LineId": 56,
            "SpeakerName": "",
            "Text": "誰も、口を開かなかった。"
        },
        {
            "LineId": 57,
            "SpeakerName": "",
            "Text": "慰めの言葉すらかけられないほど重い絶望が、部屋を押し潰していた。"
        },
        {
            "LineId": 58,
            "SpeakerName": "",
            "Text": "沈黙だけが漂う控室の中、唯一点いているのは、壁掛けのテレビだけ。"
        },
        {
            "LineId": 59,
            "SpeakerName": "MC",
            "Text": ""
        },
        {
            "LineId": 60,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 61,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 62,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 63,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 64,
            "SpeakerName": "",
            "Text": "資本が作り出した、最も完璧で燦然たる楽園。"
        },
        {
            "LineId": 65,
            "SpeakerName": "",
            "Text": "そして、その楽園から徹底的に追放されたまま、暗い控室のソファに座り、血の滲む膝を抱えて画面をぼんやりと見上げる、五人の透明人間たち。"
        },
        {
            "LineId": 66,
            "SpeakerName": "",
            "Text": "テレビから溢れる眩い光が、魂の抜けた子どもたちの空っぽの瞳を、残酷に照らし出していた。"
        },
        {
            "LineId": 67,
            "SpeakerName": "",
            "Text": "この世界のどんな努力をもってしても、あの巨大な暴力には勝てないのだと——彼ら全員が骨身に沁みて思い知った、夜だった。"
        }
    ]
}
