        {
            "LineId": 1,
            "LineTypeName": "NARRATION",
            "SpeakerId": "",
            "SpeakerName": "",
            "Text": "쿵, 쿵, 쿵!",
            "BackgroundId": "",
            "CharacterId": "",
            "ExpressionId": "",
            "RightCharacterId": "",
            "RightExpressionId": "",
            "IllustrationId": "",
            "TextSpeedName": "WORD_BY_WORD",
