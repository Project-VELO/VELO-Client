{
    "SchemaVersion": 1,
    "StoryId": "STORY_PROLOGUE_06",
    "Lines": [
        {
            "LineId": 1,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 2,
            "SpeakerName": "",
            "Text": "寿命の尽きかけた古い扇風機が、がたつきながら生温い風を吐き出している。"
        },
        {
            "LineId": 3,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 4,
            "SpeakerName": "",
            "Text": "[差押(さしおさえ)]"
        },
        {
            "LineId": 5,
            "SpeakerName": "",
            "Text": "裁判所の執行官たちが土足で踏み荒らしていった跡に残された、真っ赤な死刑宣告。"
        },
        {
            "LineId": 6,
            "SpeakerName": "",
            "Text": "そのおぞましい紙切れの間に埋もれたまま、Pは両手に顔をうずめ、机に突っ伏している。"
        },
        {
            "LineId": 7,
            "SpeakerName": "",
            "Text": "彼の指の間から、皺くちゃの書類と印刷されたメールが、血痕のように無惨に散らばっている。"
        },
        {
            "LineId": 8,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 9,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 10,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 11,
            "SpeakerName": "",
            "Text": "威勢よく巨大資本の頬を張り飛ばして飛び出してから、1年。"
        },
        {
            "LineId": 12,
            "SpeakerName": "",
            "Text": "Pは、自分の曲と子どもたちの汗さえあれば、固く閉ざされた世界の扉もこじ開けられると信じていた。"
        },
        {
            "LineId": 13,
            "SpeakerName": "",
            "Text": "だが、資本の張り巡らせた障壁は、想像を絶するほど緻密で、残忍だった。"
        },
        {
            "LineId": 14,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 15,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 16,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 17,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 18,
            "SpeakerName": "",
            "Text": "違約金に全財産を注ぎ込み、高利貸しにまで手を出した会社は、ついに破産寸前まで追い込まれた。"
        },
        {
            "LineId": 19,
            "SpeakerName": "",
            "Text": "ヴー、ヴー——"
        },
        {
            "LineId": 20,
            "SpeakerName": "",
            "Text": "液晶が蜘蛛の巣のようにひび割れたスマートフォンが、短く震える。"
        },
        {
            "LineId": 21,
            "SpeakerName": "",
            "Text": "[口座残高:7,420ウォン]"
        },
        {
            "LineId": 22,
            "SpeakerName": "",
            "Text": "明日、子どもたちの口に押し込むコンビニ弁当を数個買えば、底をつく金。"
        },
        {
            "LineId": 23,
            "SpeakerName": "",
            "Text": "Pは血走った目でその乾いた数字を睨みつけ、やがて獣のような呻き声を上げて、自分の髪を掻きむしる。"
        },
        {
            "LineId": 24,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 25,
            "SpeakerName": "",
            "Text": "その時だった。"
        },
        {
            "LineId": 26,
            "SpeakerName": "",
            "Text": "ドンッ!タタッ、ドンッ——!!"
        },
        {
            "LineId": 27,
            "SpeakerName": "",
            "Text": "薄いベニヤの扉の向こうから、重い振動とともに、荒々しい摩擦音が押し寄せ始める。"
        },
        {
            "LineId": 28,
            "SpeakerName": "",
            "Text": "Pは赤くなった目を上げ、古びたブラインドの隙間から練習室を覗き込む。"
        },
        {
            "LineId": 29,
            "SpeakerName": "",
            "Text": "差押の紙を貼られて使えなくなったアンプの代わりに、床に伏せられたスマートフォンから、安っぽいビートが流れている。"
        },
        {
            "LineId": 30,
            "SpeakerName": "",
            "Text": "そしてその割れんばかりの音の上で、汗だくの五人の少女が、床を打ち砕く勢いでステップを踏んでいた。"
        },
        {
            "LineId": 31,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 32,
            "SpeakerName": "ミナ",
            "Text": ""
        },
        {
            "LineId": 33,
            "SpeakerName": "ミナ",
            "Text": ""
        },
        {
            "LineId": 34,
            "SpeakerName": "ソユン",
            "Text": ""
        },
        {
            "LineId": 35,
            "SpeakerName": "ソユン",
            "Text": ""
        },
        {
            "LineId": 36,
            "SpeakerName": "ミナ",
            "Text": ""
        },
        {
            "LineId": 37,
            "SpeakerName": "ソユン",
            "Text": "(どこ吹く風で、おどけた敬礼をしながら)はいっ!ミナ先生のご機嫌を損ねぬよう、脊柱をまっすぐ維持いたします!"
        },
        {
            "LineId": 38,
            "SpeakerName": "",
            "Text": "ミナは苛立たしげに額を押さえるが、憎からず睨むその瞳の端には、不思議な活気が宿っている。"
        },
        {
            "LineId": 39,
            "SpeakerName": "",
            "Text": "ミナの厳格な完璧主義と、ソユンの打たれ強いポジティブエネルギーが、暗い地下室の空気を張り詰めるように引き上げていた。"
        },
        {
            "LineId": 40,
            "SpeakerName": "リア",
            "Text": ""
        },
        {
            "LineId": 41,
            "SpeakerName": "リア",
            "Text": ""
        },
        {
            "LineId": 42,
            "SpeakerName": "ジウ",
            "Text": "(素直に頷く)ううん、お姉ちゃん!私がつま先をもう少し引き寄せるね。"
        },
        {
            "LineId": 43,
            "SpeakerName": "ジウ",
            "Text": "それとハナお姉ちゃん、さっきの入りのタイミング、すごく良かったよ!"
        },
        {
            "LineId": 44,
            "SpeakerName": "ハナ",
            "Text": ""
        },
        {
            "LineId": 45,
            "SpeakerName": "リア",
            "Text": "(床の埃をぱっぱと払い、明るく笑う)よし!Pがいつ、私たちのステージをもぎ取ってきてくれるか分からないんだから。"
        },
        {
            "LineId": 46,
            "SpeakerName": "リア",
            "Text": "真っ暗な夜中に叩き起こされて音楽をかけられても、本能で飛び出せるように——最初からもう一回いくよ!スリー、フォー!"
        },
        {
            "LineId": 47,
            "SpeakerName": "",
            "Text": "再び音楽が弾け、子どもたちの眼光が一変して、虚空を切り裂く。"
        },
        {
            "LineId": 48,
            "SpeakerName": "",
            "Text": "ブラインドの隙間からその猛烈な踊りを見つめるPの瞳が、波のように揺らめく。"
        },
        {
            "LineId": 49,
            "SpeakerName": "",
            "Text": "電気さえ止められかけている、この湿って息苦しい地下室。"
        },
        {
            "LineId": 50,
            "SpeakerName": "",
            "Text": "カップラーメンで食いつなぎ、頬のこけた顔。"
        },
        {
            "LineId": 51,
            "SpeakerName": "",
            "Text": "それでも子どもたちの瞳には、不思議なほど、ひとかけらの疑いも絶望も滲んでいない。"
        },
        {
            "LineId": 52,
            "SpeakerName": "",
            "Text": "あのおぞましい赤い烙印の間でさえ、子どもたちは、自分たちを掬い上げてくれたPが世界で一番眩しいステージへ導いてくれるという、盲目的な信頼ひとつを頼りに、宙へ軌跡を描き続けていた。"
        },
        {
            "LineId": 53,
            "SpeakerName": "",
            "Text": "世界がどれほど透明人間扱いして踏みにじろうと、彼女たちの夢は決して折れることなく、暗闇の中で燃え続けていた。"
        },
        {
            "LineId": 54,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 55,
            "SpeakerName": "",
            "Text": "昨日の夜、ジウたちがラーメンを買って残ったお釣りだと言って、Pの机の上へそっと握らせていった「3,500ウォン」。"
        },
        {
            "LineId": 56,
            "SpeakerName": "",
            "Text": "貧しい少女たちが、自分たちの取り分を進んで削って差し出した、世界で最も重く、気の遠くなるような温もり。"
        },
        {
            "LineId": 57,
            "SpeakerName": "",
            "Text": "Pはゆっくりと手を伸ばし、その3,500ウォンを握りしめる。"
        },
        {
            "LineId": 58,
            "SpeakerName": "",
            "Text": "汗ばんだ彼の手の中で、古びた紙幣が千切れそうなほど固く握り込まれる。"
        },
        {
            "LineId": 59,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 60,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 61,
            "SpeakerName": "",
            "Text": "Pの血走った瞳から、押し潰されていた自己嫌悪が蒸発し、その場所に、冷ややかで猛烈な毒気が満ちていく。"
        },
        {
            "LineId": 62,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 63,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 64,
            "SpeakerName": "",
            "Text": "Pは席から勢いよく立ち上がり、椅子にかけてあった皺だらけのジャケットを掴む。"
        },
        {
            "LineId": 65,
            "SpeakerName": "",
            "Text": "口座残高は7,420ウォンだけ。"
        },
        {
            "LineId": 66,
            "SpeakerName": "",
            "Text": "世界のすべてのルールが彼らの首を荒々しく絞めつけていたが、薄いベニヤ板の向こうから聞こえてくる子どもたちの熱い息遣いが、彼の折れかけた背骨を、もう一度まっすぐに立て直していた。"
        },
        {
            "LineId": 67,
            "SpeakerName": "",
            "Text": "彼はもう一度、巨大資本の固く閉ざされた城壁に頭から突っ込み、引き裂かれる覚悟で——古びた革靴を突っかけ、執務室の扉を後にする。"
        }
    ]
}
