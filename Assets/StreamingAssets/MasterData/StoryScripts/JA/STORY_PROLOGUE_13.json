{
    "SchemaVersion": 1,
    "StoryId": "STORY_PROLOGUE_13",
    "Lines": [
        {
            "LineId": 1,
            "SpeakerName": "",
            "Text": "キイイィ——"
        },
        {
            "LineId": 2,
            "SpeakerName": "",
            "Text": "鼓膜を切り裂くような耳鳴りとともに、空間の捻じれるような、凄まじい眩暈が押し寄せる。"
        },
        {
            "LineId": 3,
            "SpeakerName": "",
            "Text": "最初に目を覚ましたのは、Pだった。"
        },
        {
            "LineId": 4,
            "SpeakerName": "",
            "Text": "巨大な波に呑まれて叩きつけられたかのように、全身の骨の節々が悲鳴を上げる。"
        },
        {
            "LineId": 5,
            "SpeakerName": "",
            "Text": "Pが呻きながら重い瞼を持ち上げた時——その網膜を埋め尽くしたのは、砕けた地下練習室のコンクリートの天井ではなかった。"
        },
        {
            "LineId": 6,
            "SpeakerName": "P",
            "Text": "……何なんだ、これは。"
        },
        {
            "LineId": 7,
            "SpeakerName": "",
            "Text": "Pの口から、呆けた呟きが漏れる。"
        },
        {
            "LineId": 8,
            "SpeakerName": "",
            "Text": "彼の眼前には、果ての見えないほど遥かに高い円形の書架が、天へ向かって伸びていた。"
        },
        {
            "LineId": 9,
            "SpeakerName": "",
            "Text": "数百万——いや、数千万巻は優に超えていそうな古書と巻物が果てしなく差し込まれ、"
        },
        {
            "LineId": 10,
            "SpeakerName": "",
            "Text": "その間を繋ぐ数百の木の階段が、自らレールを走って、忙しなく動き回っている。"
        },
        {
            "LineId": 11,
            "SpeakerName": "",
            "Text": "照明ひとつない空間でありながら、決して暗くはない。"
        },
        {
            "LineId": 12,
            "SpeakerName": "",
            "Text": "宙には蛍のように輝く紫の星雲の粒子が天の川のように流れ、"
        },
        {
            "LineId": 13,
            "SpeakerName": "",
            "Text": "開かれた羊皮紙や書物が、巨大な鳥の群れのように羽ばたきながら、宙を飛び交っていた。"
        },
        {
            "LineId": 14,
            "SpeakerName": "",
            "Text": "現実の物理法則が完全に崩壊した、夢幻にして圧倒的な、図書館の風景だった。"
        },
        {
            "LineId": 15,
            "SpeakerName": "P",
            "Text": "(慌てて身を起こし、辺りを見回す)みんな!!しっかりしろ!大丈夫か!?"
        },
        {
            "LineId": 16,
            "SpeakerName": "",
            "Text": "冷たい大理石の床に倒れていた少女たちが、苦しげに、ひとり、またひとりと身じろぎを始める。"
        },
        {
            "LineId": 17,
            "SpeakerName": "ミナ",
            "Text": "(頭を抱え、蒼白な顔で起き上がる)うっ……吐きそう……"
        },
        {
            "LineId": 18,
            "SpeakerName": "ミナ",
            "Text": "空間がぐにゃぐにゃ歪んだと思ったら……ここ、いったい、どこなの……?"
        },
        {
            "LineId": 19,
            "SpeakerName": "リア",
            "Text": "(脚の力が抜けて座り込んだまま、がたがたと震える)P……これ、いったい何が起きてるんですか……?"
        },
        {
            "LineId": 20,
            "SpeakerName": "リア",
            "Text": "壁が全部、本でできてる……"
        },
        {
            "LineId": 21,
            "SpeakerName": "ソユン",
            "Text": "(宙を飛び交う本たちを、ぼんやりと見上げる)………。"
        },
        {
            "LineId": 22,
            "SpeakerName": "",
            "Text": "眼前に広がる、人間の理性を超えた異界の風景。彼らは本能的な恐怖に、呑まれるほかなかった。"
        },
        {
            "LineId": 23,
            "SpeakerName": "",
            "Text": "その時だった。"
        },
        {
            "LineId": 24,
            "SpeakerName": "",
            "Text": "彼らの耳に、市場のように賑やかな喧騒が届き始める。"
        },
        {
            "LineId": 25,
            "SpeakerName": "幽霊1",
            "Text": "おい!3区域の「井戸の幽霊」のテキスト、恨(ハン)が足りてないじゃないか!"
        },
        {
            "LineId": 26,
            "SpeakerName": "幽霊1",
            "Text": "今すぐ原稿用紙を持ってきて、悲しみの情感をもっと書き込め!!"
        },
        {
            "LineId": 27,
            "SpeakerName": "妖怪1",
            "Text": "ああもう!今日が返却期限なのに、起承転結が全部こんがらがってるんだよ!"
        },
        {
            "LineId": 28,
            "SpeakerName": "妖怪1",
            "Text": "4区域の司書たち、早く応援に来てくれ!!"
        },
        {
            "LineId": 29,
            "SpeakerName": "トッケビ1",
            "Text": "すみません、道を空けてください!荷車が通ります!"
        },
        {
            "LineId": 30,
            "SpeakerName": "",
            "Text": "Pと子どもたちが声のする方へ顔を向けると、その奇怪な壮麗さの中に隠れていた、図書館の真の姿が露わになる。"
        },
        {
            "LineId": 31,
            "SpeakerName": "",
            "Text": "山のような本を荷車に積んで駆けていく角の生えたトッケビたち、首が奇怪に折れ曲がったまま宙を漂い、書架に本を差し込んでいく怨霊たち、"
        },
        {
            "LineId": 32,
            "SpeakerName": "",
            "Text": "数十本の腕を伸ばして飛び交う紙を掴み取る巨大な妖怪たちまで。"
        },
        {
            "LineId": 33,
            "SpeakerName": "",
            "Text": "この巨大な図書館は、ありとあらゆる霊的存在たちがそれぞれの業務に追われて、狂ったように回転する——まさに「ピークタイム」の職場、そのものだった。"
        },
        {
            "LineId": 34,
            "SpeakerName": "",
            "Text": "その混沌の中、ジウの膝を枕に気を失っていたハナが、ゆっくりと目を開ける。"
        },
        {
            "LineId": 35,
            "SpeakerName": "ハナ",
            "Text": "(朦朧とした声で)ん……ジウ……ドッキリ、もう終わった……?"
        },
        {
            "LineId": 36,
            "SpeakerName": "",
            "Text": "ハナが、虚ろな目を瞬かせる。"
        },
        {
            "LineId": 37,
            "SpeakerName": "",
            "Text": "ところが——その視界の真ん中に、何か大きくて蒼白いものが、ぷかぷかと浮かんでいた。"
        },
        {
            "LineId": 38,
            "SpeakerName": "",
            "Text": "書架を整理していた、頭から血を流し続ける娘の幽霊が、首を傾げながらハナの顔のすぐ前まで近づき、じっと見下ろしていたのだ。"
        },
        {
            "LineId": 39,
            "SpeakerName": "娘の幽霊",
            "Text": "あらら……?息のある人間だわ……?どうやって入ってきたのかしら……?"
        },
        {
            "LineId": 40,
            "SpeakerName": "",
            "Text": "幽霊と目の合ったハナの瞳孔が、点のように縮む。"
        },
        {
            "LineId": 41,
            "SpeakerName": "",
            "Text": "口をぱくぱくさせた彼女は、悲鳴すら上げられないまま、白目を剥いて再び気絶してしまった。"
        },
        {
            "LineId": 42,
            "SpeakerName": "ジウ",
            "Text": "(真っ青になってハナを抱きしめ、震える)ハ、ハナお姉ちゃん!!きゃああっ!!"
        },
        {
            "LineId": 43,
            "SpeakerName": "ジウ",
            "Text": "あっち行って!!こっちに来ないで!!"
        },
        {
            "LineId": 44,
            "SpeakerName": "P",
            "Text": "(子どもたちを背中に庇い、娘の幽霊の前に立ちはだかる)下がれ!!近づくな!!"
        },
        {
            "LineId": 45,
            "SpeakerName": "",
            "Text": "Pが血走った目で防御の構えを取る。"
        },
        {
            "LineId": 46,
            "SpeakerName": "",
            "Text": "今にもあの無数の妖怪と幽霊たちが、彼らを喰らおうと襲いかかってきそうで、背筋に冷や汗が流れる。"
        },
        {
            "LineId": 47,
            "SpeakerName": "",
            "Text": "——まさに、その瞬間だった。"
        },
        {
            "LineId": 48,
            "SpeakerName": "モング",
            "Text": "はいはい!どいてどいて!みんな、床にインクをこぼさないように気をつけて!!"
        },
        {
            "LineId": 49,
            "SpeakerName": "",
            "Text": "幽霊と妖怪がひしめき合う隙間から、何やら小さくて丸い姿が、忙しなく飛び出してくる。"
        },
        {
            "LineId": 50,
            "SpeakerName": "",
            "Text": "ベストをきちんと着込み、片目に金縁の片眼鏡をかけた、毛むくじゃらの妖怪。"
        },
        {
            "LineId": 51,
            "SpeakerName": "",
            "Text": "フクロウとタヌキを混ぜたような愛嬌のある姿のその妖怪は、羽根ペンの挿さった分厚い帳簿を抱え、ちょこちょこと駆け寄ってきた。"
        },
        {
            "LineId": 52,
            "SpeakerName": "モング",
            "Text": "(娘の幽霊に向かって帳簿を振りかざしながら)ちょっと、2区域の司書!仕事もしないで何をしてるんですか!"
        },
        {
            "LineId": 53,
            "SpeakerName": "モング",
            "Text": "今、2区域はパンク寸前だっていうのに!早く行って、羊皮紙を運んでください!"
        },
        {
            "LineId": 54,
            "SpeakerName": "娘の幽霊",
            "Text": "ちぇっ、細かいんだから。"
        },
        {
            "LineId": 55,
            "SpeakerName": "",
            "Text": "娘の幽霊が、すうっと宙へ消えていく。"
        },
        {
            "LineId": 56,
            "SpeakerName": "",
            "Text": "片眼鏡の妖怪は小さく咳払いをすると、警戒心を剥き出しにするPと子どもたちに向かって、恭しく腰を折る。"
        },
        {
            "LineId": 57,
            "SpeakerName": "モング",
            "Text": "驚かせてしまい、申し訳ございません。今がちょうど、物語の返却期限が集中するピークタイムでございまして。"
        },
        {
            "LineId": 58,
            "SpeakerName": "モング",
            "Text": "目の回る忙しさなのです。"
        },
        {
            "LineId": 59,
            "SpeakerName": "P",
            "Text": "(戸惑いながら)お前……いや、あなたは、何者ですか……?"
        },
        {
            "LineId": 60,
            "SpeakerName": "モング",
            "Text": "(片眼鏡をくいっと押し上げながら)私は影謡書庫の首席司書補佐、「モング」と申します。"
        },
        {
            "LineId": 61,
            "SpeakerName": "モング",
            "Text": "遠く険しい道のりを、ようこそおいでくださいました。"
        },
        {
            "LineId": 62,
            "SpeakerName": "モング",
            "Text": "館長が、貴賓の皆様のご到着を、今か今かとお待ちでございます。さあ、私についてお越しください。"
        },
        {
            "LineId": 63,
            "SpeakerName": "",
            "Text": "モングが、ちょこちょこと先導を始める。"
        },
        {
            "LineId": 64,
            "SpeakerName": "",
            "Text": "Pと子どもたちは、いまだ恐怖に強張ったまま互いの手を固く握り、その小さな妖怪の後を追って歩き始める。"
        },
        {
            "LineId": 65,
            "SpeakerName": "",
            "Text": "彼らの歩く回廊の両側では、宙を遊泳する数百冊の本が紫の光を放ちながら通り過ぎ、"
        },
        {
            "LineId": 66,
            "SpeakerName": "",
            "Text": "壮麗な書架の合間から、霊的な存在たちが興味深げに彼らを盗み見ていた。"
        },
        {
            "LineId": 67,
            "SpeakerName": "",
            "Text": "ソユンは物珍しげに辺りを見回し、ミナは周囲の奇怪な風景に辟易したのか、目を半分閉じたまま、Pの服の裾を掴んで歩く。"
        },
        {
            "LineId": 68,
            "SpeakerName": "",
            "Text": "やがて——果ての知れない壮麗な図書館の、中心部。"
        },
        {
            "LineId": 69,
            "SpeakerName": "",
            "Text": "巨大なマホガニーの原木で作られた観音開きの扉の前に到着する。"
        },
        {
            "LineId": 70,
            "SpeakerName": "",
            "Text": "扉には幾何学的な蝶の紋様が、金色に刻まれていた。"
        },
        {
            "LineId": 71,
            "SpeakerName": "モング",
            "Text": "館長。お待ちかねのお客様がたを、お連れいたしました。"
        },
        {
            "LineId": 72,
            "SpeakerName": "",
            "Text": "ギイイィ——"
        },
        {
            "LineId": 73,
            "SpeakerName": "",
            "Text": "重厚な扉がひとりでに開き、紫の星雲が静かに揺らめく、広い執務室が姿を現す。"
        },
        {
            "LineId": 74,
            "SpeakerName": "",
            "Text": "床には血の色の絨毯が敷かれ、片側の壁面を埋め尽くす巨大な窓の向こうには、現世では見ることの叶わない宇宙の星々が、零れ落ちそうなほど瞬いている。"
        },
        {
            "LineId": 75,
            "SpeakerName": "",
            "Text": "そして、その部屋の中央。"
        },
        {
            "LineId": 76,
            "SpeakerName": "",
            "Text": "紫のスーツに真っ白な仮面を着けた館長「無名」が、優雅な佇まいで立っていた。"
        },
        {
            "LineId": 77,
            "SpeakerName": "",
            "Text": "無名が被っていた中折れ帽を脱いで胸に当て、低く夢幻的な声で口を開く。"
        },
        {
            "LineId": 78,
            "SpeakerName": "無名",
            "Text": "次元の狭間を越える長旅、さぞお疲れでございましょう——Pさん。そして——小さな鳥たち。"
        },
        {
            "LineId": 79,
            "SpeakerName": "P",
            "Text": "……?"
        },
        {
            "LineId": 80,
            "SpeakerName": "無名",
            "Text": "(仮面の奥で、濃い紫の眼光を閃かせる)すべての光が消えたあなたがたの、真のステージ——影謡書庫(えいようしょこ)へ。心より、歓迎申し上げます。"
        },
        {
            "LineId": 81,
            "SpeakerName": "",
            "Text": "ガアンッ——!"
        },
        {
            "LineId": 82,
            "SpeakerName": "",
            "Text": "無名の夢幻的な歓迎の言葉とともに、背後の重厚な扉が固く閉ざされ——"
        },
        {
            "LineId": 83,
            "SpeakerName": "",
            "Text": "Pと子どもたちの、奇怪なる怪談(かいだん)の最初のページが、いま、ついに開かれようとしていた。"
        }
    ]
}
