{
    "SchemaVersion": 1,
    "StoryId": "STORY_PROLOGUE_11",
    "Lines": [
        {
            "LineId": 1,
            "SpeakerName": "P(モノローグ)",
            "Text": "最も寒く、暗い夜。この子たちに明日は来ないような気がした。"
        },
        {
            "LineId": 2,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 3,
            "SpeakerName": "P(モノローグ)",
            "Text": "僕たちが夢見たステージは、カビの生えた地下室の床へと墜ちてしまった。"
        },
        {
            "LineId": 4,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 5,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 6,
            "SpeakerName": "P(モノローグ)",
            "Text": "……そして、すべてを諦めようとした、その瞬間。"
        },
        {
            "LineId": 7,
            "SpeakerName": "",
            "Text": "すべての光が消えたあなたを、\n深淵の世界へご招待します。"
        }
    ]
}
