{
    "SchemaVersion": 1,
    "StoryId": "STORY_PROLOGUE_13",
    "Lines": [
        {
            "LineId": 1,
            "SpeakerName": "",
            "Text": "キイイィ——"
        },
        {
            "LineId": 2,
            "SpeakerName": "",
            "Text": "鼓膜を切り裂くような耳鳴りとともに、空間の捻じれるような、凄まじい眩暈が押し寄せる。"
        },
        {
            "LineId": 3,
            "SpeakerName": "",
            "Text": "最初に目を覚ましたのは、Pだった。"
        },
        {
            "LineId": 4,
            "SpeakerName": "",
            "Text": "巨大な波に呑まれて叩きつけられたかのように、全身の骨の節々が悲鳴を上げる。"
        },
        {
            "LineId": 5,
            "SpeakerName": "",
            "Text": "Pが呻きながら重い瞼を持ち上げた時——その網膜を埋め尽くしたのは、砕けた地下練習室のコンクリートの天井ではなかった。"
        },
        {
            "LineId": 6,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 7,
            "SpeakerName": "",
            "Text": "Pの口から、呆けた呟きが漏れる。"
        },
        {
            "LineId": 8,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 9,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 10,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 11,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 12,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 13,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 14,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 15,
            "SpeakerName": "P",
            "Text": "(慌てて身を起こし、辺りを見回す)みんな!!しっかりしろ!大丈夫か!?"
        },
        {
            "LineId": 16,
            "SpeakerName": "",
            "Text": "冷たい大理石の床に倒れていた少女たちが、苦しげに、ひとり、またひとりと身じろぎを始める。"
        },
        {
            "LineId": 17,
            "SpeakerName": "ミナ",
            "Text": ""
        },
        {
            "LineId": 18,
            "SpeakerName": "ミナ",
            "Text": ""
        },
        {
            "LineId": 19,
            "SpeakerName": "リア",
            "Text": ""
        },
        {
            "LineId": 20,
            "SpeakerName": "リア",
            "Text": ""
        },
        {
            "LineId": 21,
            "SpeakerName": "ソユン",
            "Text": ""
        },
        {
            "LineId": 22,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 23,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 24,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 25,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 26,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 27,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 28,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 29,
            "SpeakerName": "",
            "Text": "すみません、道を空けてください!荷車が通ります!"
        },
        {
            "LineId": 30,
            "SpeakerName": "",
            "Text": "Pと子どもたちが声のする方へ顔を向けると、その奇怪な壮麗さの中に隠れていた、図書館の真の姿が露わになる。"
        },
        {
            "LineId": 31,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 32,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 33,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 34,
            "SpeakerName": "",
            "Text": "その混沌の中、ジウの膝を枕に気を失っていたハナが、ゆっくりと目を開ける。"
        },
        {
            "LineId": 35,
            "SpeakerName": "ハナ",
            "Text": ""
        },
        {
            "LineId": 36,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 37,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 38,
            "SpeakerName": "",
            "Text": "書架を整理していた、頭から血を流し続ける娘の幽霊が、首を傾げながらハナの顔のすぐ前まで近づき、じっと見下ろしていたのだ。"
        },
        {
            "LineId": 39,
            "SpeakerName": "娘の幽霊",
            "Text": ""
        },
        {
            "LineId": 40,
            "SpeakerName": "",
            "Text": "幽霊と目の合ったハナの瞳孔が、点のように縮む。"
        },
        {
            "LineId": 41,
            "SpeakerName": "",
            "Text": "口をぱくぱくさせた彼女は、悲鳴すら上げられないまま、白目を剥いて再び気絶してしまった。"
        },
        {
            "LineId": 42,
            "SpeakerName": "ジウ",
            "Text": ""
        },
        {
            "LineId": 43,
            "SpeakerName": "ジウ",
            "Text": ""
        },
        {
            "LineId": 44,
            "SpeakerName": "P",
            "Text": "(子どもたちを背中に庇い、娘の幽霊の前に立ちはだかる)下がれ!!近づくな!!"
        },
        {
            "LineId": 45,
            "SpeakerName": "",
            "Text": "Pが血走った目で防御の構えを取る。"
        },
        {
            "LineId": 46,
            "SpeakerName": "",
            "Text": "今にもあの無数の妖怪と幽霊たちが、彼らを喰らおうと襲いかかってきそうで、背筋に冷や汗が流れる。"
        },
        {
            "LineId": 47,
            "SpeakerName": "",
            "Text": "——まさに、その瞬間だった。"
        },
        {
            "LineId": 48,
            "SpeakerName": "モング",
            "Text": "はいはい!どいてどいて!みんな、床にインクをこぼさないように気をつけて!!"
        },
        {
            "LineId": 49,
            "SpeakerName": "",
            "Text": "幽霊と妖怪がひしめき合う隙間から、何やら小さくて丸い姿が、忙しなく飛び出してくる。"
        },
        {
            "LineId": 50,
            "SpeakerName": "",
            "Text": "ベストをきちんと着込み、片目に金縁の片眼鏡をかけた、毛むくじゃらの妖怪。"
        },
        {
            "LineId": 51,
            "SpeakerName": "",
            "Text": "フクロウとタヌキを混ぜたような愛嬌のある姿のその妖怪は、羽根ペンの挿さった分厚い帳簿を抱え、ちょこちょこと駆け寄ってきた。"
        },
        {
            "LineId": 52,
            "SpeakerName": "モング",
            "Text": ""
        },
        {
            "LineId": 53,
            "SpeakerName": "モング",
            "Text": ""
        },
        {
            "LineId": 54,
            "SpeakerName": "娘の幽霊",
            "Text": ""
        },
        {
            "LineId": 55,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 56,
            "SpeakerName": "",
            "Text": "片眼鏡の妖怪は小さく咳払いをすると、警戒心を剥き出しにするPと子どもたちに向かって、恭しく腰を折る。"
        },
        {
            "LineId": 57,
            "SpeakerName": "モング",
            "Text": ""
        },
        {
            "LineId": 58,
            "SpeakerName": "モング",
            "Text": ""
        },
        {
            "LineId": 59,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 60,
            "SpeakerName": "モング",
            "Text": ""
        },
        {
            "LineId": 61,
            "SpeakerName": "モング",
            "Text": ""
        },
        {
            "LineId": 62,
            "SpeakerName": "モング",
            "Text": ""
        },
        {
            "LineId": 63,
            "SpeakerName": "",
            "Text": "モングが、ちょこちょこと先導を始める。"
        },
        {
            "LineId": 64,
            "SpeakerName": "",
            "Text": "Pと子どもたちは、いまだ恐怖に強張ったまま互いの手を固く握り、その小さな妖怪の後を追って歩き始める。"
        },
        {
            "LineId": 65,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 66,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 67,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 68,
            "SpeakerName": "",
            "Text": "やがて——果ての知れない壮麗な図書館の、中心部。"
        },
        {
            "LineId": 69,
            "SpeakerName": "",
            "Text": "巨大なマホガニーの原木で作られた観音開きの扉の前に到着する。"
        },
        {
            "LineId": 70,
            "SpeakerName": "",
            "Text": "扉には幾何学的な蝶の紋様が、金色に刻まれていた。"
        },
        {
            "LineId": 71,
            "SpeakerName": "モング",
            "Text": ""
        },
        {
            "LineId": 72,
            "SpeakerName": "",
            "Text": "ギイイィ——"
        },
        {
            "LineId": 73,
            "SpeakerName": "",
            "Text": "重厚な扉がひとりでに開き、紫の星雲が静かに揺らめく、広い執務室が姿を現す。"
        },
        {
            "LineId": 74,
            "SpeakerName": "",
            "Text": "床には血の色の絨毯が敷かれ、片側の壁面を埋め尽くす巨大な窓の向こうには、現世では見ることの叶わない宇宙の星々が、零れ落ちそうなほど瞬いている。"
        },
        {
            "LineId": 75,
            "SpeakerName": "",
            "Text": "そして、その部屋の中央。"
        },
        {
            "LineId": 76,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 77,
            "SpeakerName": "",
            "Text": "無名が被っていた中折れ帽を脱いで胸に当て、低く夢幻的な声で口を開く。"
        },
        {
            "LineId": 78,
            "SpeakerName": "無名",
            "Text": ""
        },
        {
            "LineId": 79,
            "SpeakerName": "P",
            "Text": ""
        },
        {
            "LineId": 80,
            "SpeakerName": "無名",
            "Text": ""
        },
        {
            "LineId": 81,
            "SpeakerName": "",
            "Text": "ガアンッ——!"
        },
        {
            "LineId": 82,
            "SpeakerName": "",
            "Text": ""
        },
        {
            "LineId": 83,
            "SpeakerName": "",
            "Text": ""
        }
    ]
}
