{
    "SchemaVersion": 1,
    "StoryId": "STORY_PROLOGUE_10",
    "Lines": [
        {
            "LineId": 1,
            "SpeakerName": "",
            "Text": "ヴーン——ヴーン——"
        },
        {
            "LineId": 2,
            "SpeakerName": "",
            "Text": "すべての生放送が終わり、スタッフと観客が潮のように引いていった、放送局のスタジオ。"
        },
        {
            "LineId": 3,
            "SpeakerName": "",
            "Text": "熱く燃え上がっていた熱気は跡形もなく冷め、メインカメラの[ON-AIR]の赤いランプも、冷たく死んでいる。"
        },
        {
            "LineId": 4,
            "SpeakerName": "",
            "Text": "華やかだった照明もすべて消えた、がらんどうのセット。機材が熱を冷ます微かなモーター音だけが、重く漂っていた。"
        },
        {
            "LineId": 5,
            "SpeakerName": "",
            "Text": "その漆黒の静寂の中。"
        },
        {
            "LineId": 6,
            "SpeakerName": "",
            "Text": "控室に閉じ込められていた五人の少女が幽霊のように歩み出て、自分たちが荷物のように引きずり下ろされた、あの空っぽのステージの上へ、再び上がっていく。"
        },
        {
            "LineId": 7,
            "SpeakerName": "",
            "Text": "ジウが足首をさすりながら、そっとステージの床を踏みしめる。"
        },
        {
            "LineId": 8,
            "SpeakerName": "",
            "Text": "幸い軽く筋を違えただけだったのか、痛みはすぐに引いて、立つのに支障はない。だがジウは、罪人のように深くうなだれていた。"
        },
        {
            "LineId": 9,
            "SpeakerName": "",
            "Text": "ソユンは魂の抜けた顔で真っ暗なメインカメラのレンズに向かって立ち、"
        },
        {
            "LineId": 10,
            "SpeakerName": "",
            "Text": "ミナは血の瘡蓋のこびりついた素足で、冷たいステージの床を撫でる。"
        },
        {
            "LineId": 11,
            "SpeakerName": "",
            "Text": "誰もいない、照明ひとつ当たらない、死んだステージ。"
        },
        {
            "LineId": 12,
            "SpeakerName": "ソユン",
            "Text": "(虚空をぼんやりと見つめ、空っぽの声で呟く)レンズの灯りが……全部消えてる……さっきは、あそこに灯りが点いたら絶対に喰らい尽くしてやるって思ってたのに……"
        },
        {
            "LineId": 13,
            "SpeakerName": "ソユン",
            "Text": "もう、何もない……"
        },
        {
            "LineId": 14,
            "SpeakerName": "ミナ",
            "Text": "(床にへたり込み、虚ろに笑う)私たちが馬鹿だったのよ。寝ないで、食べないで、爪が剥がれるまで転がり回って、何になるの。"
        },
        {
            "LineId": 15,
            "SpeakerName": "ミナ",
            "Text": "S-Tierの電話一本で、3秒で消える照明だったのに。"
        },
        {
            "LineId": 16,
            "SpeakerName": "ミナ",
            "Text": "最初から……私たちに許されたステージなんて、なかったのよ。"
        },
        {
            "LineId": 17,
            "SpeakerName": "ハナ",
            "Text": "もう……本当に終わりなんだよね……?これ以上……できないんだよね……?"
        },
        {
            "LineId": 18,
            "SpeakerName": "ジウ",
            "Text": "(すっかり良くなった足首を恨めしげに見下ろし、泣き出す)いっそ……骨でも折れてればよかったのに……ぐすっ、踊れるのに……"
        },
        {
            "LineId": 19,
            "SpeakerName": "ジウ",
            "Text": "転ばなければ、あと1秒でも持ちこたえられたのに……私のせいで、全部台無しに……"
        },
        {
            "LineId": 20,
            "SpeakerName": "リア",
            "Text": "(涙まみれのまま、ジウとハナを抱き寄せる)ジウのせいじゃない……誰も、ジウのせいだなんて思ってないよ……"
        },
        {
            "LineId": 21,
            "SpeakerName": "",
            "Text": "床に座り込み、互いを抱きしめて泣きじゃくる少女たち。"
        },
        {
            "LineId": 22,
            "SpeakerName": "",
            "Text": "その凄惨な敗北の現場をステージの下から見つめるPの顔は、死人のように白く染まっていた。"
        },
        {
            "LineId": 23,
            "SpeakerName": "",
            "Text": "資本という鉄壁の前では、情熱も、才能も、血の滲むような努力も——何の価値も持たなかった。"
        },
        {
            "LineId": 24,
            "SpeakerName": "",
            "Text": "「大丈夫だ」と。「またステージを取ってくる」と。いつものように無理やりな慰めでも口にすべきだったが、"
        },
        {
            "LineId": 25,
            "SpeakerName": "",
            "Text": "Pは顔を上げることすらできず、床に視線を突き刺していた。"
        },
        {
            "LineId": 26,
            "SpeakerName": "",
            "Text": "この世界のどんな希望の言葉も、この完全なる絶望の前では、欺瞞に過ぎなかったから。"
        },
        {
            "LineId": 27,
            "SpeakerName": "",
            "Text": "あの浅ましい人間の理性が、完膚なきまでに砕け散った瞬間だった。"
        },
        {
            "LineId": 28,
            "SpeakerName": "",
            "Text": "スゥゥゥ……"
        },
        {
            "LineId": 29,
            "SpeakerName": "",
            "Text": "突如、がらんどうのセットの空気の流れが、夢幻のように捻じれ始める。"
        },
        {
            "LineId": 30,
            "SpeakerName": "",
            "Text": "唸っていた機械音が、真空へ吸い込まれるように完全に消え去り、"
        },
        {
            "LineId": 31,
            "SpeakerName": "",
            "Text": "暗い宙を漂っていた埃の粒子が、重力を失ったかのように空中で静かに止まる。"
        },
        {
            "LineId": 32,
            "SpeakerName": "",
            "Text": "時間が凍りついたかのような、奇怪な静寂。"
        },
        {
            "LineId": 33,
            "SpeakerName": "",
            "Text": "だが、絶望の重みに押し潰されてうなだれるPと、"
        },
        {
            "LineId": 34,
            "SpeakerName": "",
            "Text": "悲しみに沈んで泣き崩れる少女たちは、自分たちの頭上——遥か高い天井の方で起きている異質な現象に、まったく気づいていない。"
        },
        {
            "LineId": 35,
            "SpeakerName": "",
            "Text": "照明が落ちて暗いはずの、あの巨大な「星形の照明セット」の上に、"
        },
        {
            "LineId": 36,
            "SpeakerName": "",
            "Text": "濃く妖しい紫紺の星雲が陽炎のように立ち昇り、揺らめいている。"
        },
        {
            "LineId": 37,
            "SpeakerName": "",
            "Text": "そしてその紫の帳を突き抜けて、この世の常識では説明のつかない一つの存在が、星の上に悠然と脚を組んで座っていた。"
        },
        {
            "LineId": 38,
            "SpeakerName": "",
            "Text": "身体の線に沿って流れ落ちるような、完璧なフィットの紫のスーツ。"
        },
        {
            "LineId": 39,
            "SpeakerName": "",
            "Text": "その上に深く被ったフェドーラは顔の半分を覆うほどの濃い影を落とし、"
        },
        {
            "LineId": 40,
            "SpeakerName": "",
            "Text": "その影の中では、表情の読めない奇怪で滑らかな白い仮面だけが、冷ややかに光っている。"
        },
        {
            "LineId": 41,
            "SpeakerName": "",
            "Text": "彼は黒い革手袋をはめた手に、数百年は優に超えていそうな、革の砕け散りそうなほど古く分厚い古書を一冊、携えていた。"
        },
        {
            "LineId": 42,
            "SpeakerName": "",
            "Text": "深淵の存在。——「無名(ムミョウ)」だった。"
        },
        {
            "LineId": 43,
            "SpeakerName": "",
            "Text": "仮面の向こうに、濃い興味が滲む。"
        },
        {
            "LineId": 44,
            "SpeakerName": "",
            "Text": "彼は書物を膝の上に置いたまま、自分の存在も知らずに獣のように苦しむPと、声もなく涙を流す少女たちを見下ろしていた。"
        },
        {
            "LineId": 45,
            "SpeakerName": "",
            "Text": "人間の血の滲む努力が巨大資本の前に踏みにじられ、最後に残った希望さえ無惨に砕け散った、この完璧な絶望の瞬間。"
        },
        {
            "LineId": 46,
            "SpeakerName": "",
            "Text": "この上なく甘美で、それでいて強烈なその血の香りが、無名の嗅覚を心地よく擽っていた。"
        },
        {
            "LineId": 47,
            "SpeakerName": "リア",
            "Text": "誰でもいいから……お願い、私たちを助けて。"
        },
        {
            "LineId": 48,
            "SpeakerName": "リア",
            "Text": "神様でも、悪魔でも構わない。私の魂を丸ごと持っていってもいいから……お願い……"
        },
        {
            "LineId": 49,
            "SpeakerName": "",
            "Text": "星の上に座る無名の、仮面に隠された唇の端が、夢幻の紫の霧の中で、奇怪にして美しい弧を描いて吊り上がる。"
        },
        {
            "LineId": 50,
            "SpeakerName": "",
            "Text": "誰にも知られず舞い降りた深淵の招待状が、人間たちの足元へ、静かに染み込み始めていた。"
        }
    ]
}
