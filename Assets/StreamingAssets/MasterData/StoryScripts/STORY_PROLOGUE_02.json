            "ExpressionId": "",
            "RightCharacterId": "",
            "RightExpressionId": "",
            "IllustrationId": "",
            "TextSpeedName": "NORMAL",
            "TextStyleId": "STYLE_NARRATION",
            "EffectId": "FX_LIGHT_COLD",
            "BgmId": "",
            "SfxId": ""
        },
        {
            "LineId": 36,
            "LineTypeName": "NARRATION",
            "SpeakerId": "",
            "SpeakerName": "",
            "Text": "[계약 해지 및 손해배상 청구서]가 흉물스럽게 뒹굴고 있었다.",
            "BackgroundId": "",
            "CharacterId": "",
