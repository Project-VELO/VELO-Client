{
    "SchemaVersion": 1,
    "StoryId": "STORY_PROLOGUE_01",
    "Lines": [
        {
            "LineId": 1,
            "SpeakerName": "",
            "Text": "ドン、ドン。"
        },
        {
            "LineId": 2,
            "SpeakerName": "",
            "Text": "漆黒の闇の中、心臓の鼓動のように、ドン、ドン、と重いベースの音が響き渡る。"
        },
        {
            "LineId": 3,
            "SpeakerName": "",
            "Text": "一瞬にして数千本の蝋燭が灯り、巨大な公演会場を照らし出す。"
        },
        {
            "LineId": 4,
            "SpeakerName": "",
            "Text": "ステージの上——黒い制服に身を包んだV.E.L.Oの五人のメンバーが、圧倒的なオーラを放ちながら立っている。"
        },
        {
            "LineId": 5,
            "SpeakerName": "P(モノローグ)",
            "Text": "アイドルの語源は、偶像。"
        },
        {
            "LineId": 6,
            "SpeakerName": "P(モノローグ)",
            "Text": "そして私たちは、その偽りの偶像のために血を流した生贄だった。"
        },
        {
            "LineId": 7,
            "SpeakerName": "P(モノローグ)",
            "Text": "人間の世界はかつて、この子たちをゴミ箱に叩き込んだが……"
        },
        {
            "LineId": 8,
            "SpeakerName": "",
            "Text": "ステージが爆発するようにクライマックスへと駆け上がる。"
        },
        {
            "LineId": 9,
            "SpeakerName": "",
            "Text": "メインボーカル・リアの高音が炸裂した瞬間、客席を埋め尽くした亡霊の観客たちが、怖気立つほど奇怪な、それでいて熱狂的な歓声を浴びせかける。"
        },
        {
            "LineId": 10,
            "SpeakerName": "観客(亡霊たち)",
            "Text": "キャアアアアアッ——!!"
        },
        {
            "LineId": 11,
            "SpeakerName": "",
            "Text": "骨の髄まで震わせる、総毛立つような——それでいて、狂おしいほど熱に浮かされた歓声。"
        },
        {
            "LineId": 12,
            "SpeakerName": "",
            "Text": "その歓声は、ただの音ではない。"
        },
        {
            "LineId": 13,
            "SpeakerName": "",
            "Text": "客席から溢れ出した亡霊たちの爆発的な熱狂が、深い青の陽炎と、光の粒子となって、宙へと立ち昇り始める。"
        },
        {
            "LineId": 14,
            "SpeakerName": "",
            "Text": "巨大なドーム会場全体が、奇怪にして美しい霊的エネルギーに揺らめく。"
        },
        {
            "LineId": 15,
            "SpeakerName": "無名",
            "Text": "(VIPバルコニーでシャンパングラスを手にしたまま)お見事です、Pさん。"
        },
        {
            "LineId": 16,
            "SpeakerName": "無名",
            "Text": "人間の薄っぺらな資本などでは決して生み出せない、完璧な熱狂。"
        },
        {
            "LineId": 17,
            "SpeakerName": "",
            "Text": "宙を漂っていた青い粒子が、まるで魔法のように無名のシャンパングラスの中へ、渦を巻いて吸い込まれていく。"
        },
        {
            "LineId": 18,
            "SpeakerName": "",
            "Text": "無名がグラスに満ちた玲瓏な光を味わうように、口角を上げる。"
        },
        {
            "LineId": 19,
            "SpeakerName": "無名",
            "Text": "どうぞ——この上質で、ずっしりと芳醇な『共鳴』の香りを、ご堪能ください。"
        },
        {
            "LineId": 20,
            "SpeakerName": "P",
            "Text": "当たり前だろ。うちの子たちがステージを喰らい尽くす腕前だけは、この世でもあの世でも、右に出る者はいないんだからな。"
        },
        {
            "LineId": 21,
            "SpeakerName": "",
            "Text": "Pは手すりにもたれ、ステージの下を見下ろしながら、ふっと笑う。"
        },
        {
            "LineId": 22,
            "SpeakerName": "P(モノローグ)",
            "Text": "薄っぺらな資本が支配する現世の舞台を追われた俺たちは、あの世の最も暗いどん底を踏みしめて這い上がり、今度は現世ごと丸呑みにしてやることにした。"
        },
        {
            "LineId": 23,
            "SpeakerName": "P(モノローグ)",
            "Text": "生者と死者、その全てを魅了する、世界で最も華麗で奇怪な怪談(かいだん)——それが、俺たちだ。"
        },
        {
            "LineId": 24,
            "SpeakerName": "",
            "Text": "ステージの上でメンバーたちが華麗なエンディングポーズを決めた、その瞬間。"
        },
        {
            "LineId": 25,
            "SpeakerName": "",
            "Text": "キイイイイッ——!!"
        },
        {
            "LineId": 26,
            "SpeakerName": "",
            "Text": "鼓膜を切り裂く鋭いマイクのハウリングとともに、ジジッと軋む不気味なノイズが走り——"
        },
        {
            "LineId": 27,
            "SpeakerName": "",
            "Text": "スイッチを切るように、世界は完全な暗黒へと変わる。"
        }
    ]
}
